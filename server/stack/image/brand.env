# The vault's public identity. One source of truth: change it here, then run
# ./deploy.sh (it rebuilds the image on the Pi). Nothing here is secret.

# Taviri is Tahitian for "key" (the owner's choice, 14 Nov 2026).
BRAND_NAME="Taviri"
BRAND_TAGLINE="Private password vault"
# Colour of the app icon and of the mark in the logo.
BRAND_COLOR="#047B62"
# "yes" turns the web vault's blue buttons and links to BRAND_COLOR as well; "no" keeps the stock blue.
RECOLOUR="yes"
# Optional line shown on the About page (an email address or a URL).
BRAND_SUPPORT=""
# Where people using this server can get its source (AGPL-3.0 section 13). Keep it pointing
# at the exact code you run: your fork, or this repository if you changed nothing.
BRAND_SOURCE_URL="https://github.com/perlytiara/taviri"

# The app the two-step-login page suggests as an example ("an authenticator app like ...").
# If the phone app ships its own authenticator, put its name and link here.
AUTHENTICATOR_APP="Ente Auth"
AUTHENTICATOR_URL="https://ente.io/auth/"
