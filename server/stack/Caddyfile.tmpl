# Generated by `vaultctl apply` from Caddyfile.tmpl and /etc/pi-vault/site.env. Edit those, not this file.
{
	admin off
	http_port __HTTP_PORT__
	https_port __HTTPS_PORT__
	skip_install_trust
	servers {
		protocols h1 h2
	}
	pki {
		ca local {
			name "__BRAND__ local authority"
			root_cn "__BRAND__ Root"
			intermediate_cn "__BRAND__ Intermediate"
		}
	}
}

(vault) {
	# Second lock behind the firewall: only the LAN, this Pi and the tailnet get an answer.
	@outside not remote_ip __LAN_CIDR__ 127.0.0.0/8 ::1 fe80::/10 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @outside

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Health page, rewritten every few minutes by `vaultctl status`.
	redir /status /status/ 308
	handle_path /status/* {
		root * /srv/status
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8732 {
			header_up X-Real-IP {remote_host}
		}
	}
}

# LAN addresses: certificates from this Pi's own authority (trust its root once per device).
__LAN_SITES__ {
	tls internal
	import vault
}
__TS_BLOCK__
# Plain HTTP only redirects to HTTPS.
http:// {
	redir https://{host}{uri} 308
}
