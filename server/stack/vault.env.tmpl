# Vault server settings. Written once by `vaultctl apply`; after that only DOMAIN is kept in sync.
# Secrets (ADMIN_TOKEN, SMTP_PASSWORD) are added on the Pi only, never in the pi-vault folder on the Mac.

DOMAIN=__PRIMARY_URL__

# Accounts: nobody can sign up; new people need an invitation.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
INVITATION_ORG_NAME=__BRAND__
SHOW_PASSWORD_HINT=false
PASSWORD_HINTS_ALLOWED=false

# No "get the browser extension" pages pointing at the upstream store listings.
CLIENT_SUPPRESS_ONBOARDING=true

# The real client address comes from Caddy on this same machine, and from nowhere else.
IP_HEADER=X-Real-IP
IP_HEADER_TRUSTED_PROXIES=127.0.0.1

# Logs feed fail2ban.
EXTENDED_LOGGING=true
LOG_LEVEL=info

# Brute-force limits inside the server (fail2ban adds firewall bans on top).
LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=10
ADMIN_RATELIMIT_SECONDS=300
ADMIN_RATELIMIT_MAX_BURST=3
ADMIN_SESSION_LIFETIME=20

# The admin page stays off unless ADMIN_TOKEN is set; `vaultctl admin-on` adds an argon2 hash below.

# Email (invitations, new-device notices). Fill in on the Pi to switch it on:
SMTP_FROM_NAME=__BRAND__
# Our emails carry no pictures (the built-in ones show the upstream logo).
SMTP_EMBED_IMAGES=false
