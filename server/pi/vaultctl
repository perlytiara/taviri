#!/usr/bin/env bash
# vaultctl: everything you do to the vault on the Pi goes through here.
# Installed to /usr/local/sbin/vaultctl by bootstrap.sh. Run as root.
set -euo pipefail

ROOT=/opt/pi-vault
STACK=$ROOT/stack
SITE=/etc/pi-vault/site.env
RECIPIENTS=/etc/pi-vault/backup-recipients.txt
DATA=/srv/pi-vault/data
STATE=/var/lib/pi-vault
BACKUPS=/var/backups/pi-vault
KEEP_LOCAL=14

die() { echo "vaultctl: $*" >&2; exit 1; }
say() { echo "==> $*"; }
need_root() { [ "$(id -u)" = 0 ] || die "run as root"; }

load_site() {
  [ -r "$SITE" ] || die "$SITE is missing (run bootstrap.sh first)"
  set -a; . "$SITE"; set +a
  BRAND=$(sed -n 's/^BRAND_NAME="\(.*\)".*/\1/p' "$STACK/image/brand.env" | head -1)
  [ -n "${BRAND:-}" ] || die "BRAND_NAME is not set in $STACK/image/brand.env"
  VAULT_UID=$(id -u pivault); VAULT_GID=$(id -g pivault)
  if [ -n "${TS_NAME:-}" ]; then PRIMARY_URL="https://$TS_NAME"; else PRIMARY_URL="https://$LAN_IP"; fi
  [ "${HTTPS_PORT:-443}" = 443 ] || PRIMARY_URL="$PRIMARY_URL:$HTTPS_PORT"
}

compose() { (cd "$STACK" && docker compose "$@"); }

set_site() {  # set_site KEY VALUE
  local key=$1 value=$2
  if grep -q "^$key=" "$SITE"; then
    sed -i "s|^$key=.*|$key=\"$value\"|" "$SITE"
  else
    echo "$key=\"$value\"" >> "$SITE"
  fi
}

dbq() {  # dbq FILE SQL   read a database copy without creating -wal/-shm files next to it
  sqlite3 "file:$1?immutable=1" "$2"
}

wait_alive() {  # wait_alive PORT SECONDS
  local port=$1 left=${2:-90}
  while [ "$left" -gt 0 ]; do
    curl -fsS -m 3 "http://127.0.0.1:$port/alive" >/dev/null 2>&1 && return 0
    sleep 2; left=$((left - 2))
  done
  return 1
}

# ------------------------------------------------------------------ apply

lan6_prefixes() {  # the home network's own IPv6 prefixes (from this Pi's addresses), comma separated
  local dev
  dev=$(ip -4 route show default | awk '{print $5; exit}')
  ip -6 -o addr show scope global dev "$dev" 2>/dev/null | awk '{print $4}' \
    | python3 -c 'import sys, ipaddress; print(", ".join(sorted({str(ipaddress.ip_interface(l.strip()).network) for l in sys.stdin if l.strip()})))'
}

render_firewall() {
  local tcp="22, ${HTTP_PORT:-80}, ${HTTPS_PORT:-443}" extra_tcp="" extra_udp="" lan6
  lan6=$(lan6_prefixes)
  for port in ${EXTRA_LAN_TCP:-}; do extra_tcp="$extra_tcp, $port"; done
  for port in ${EXTRA_LAN_UDP:-}; do extra_udp="${extra_udp:+$extra_udp, }$port"; done
  {
    echo "# Generated by \`vaultctl apply\` from /etc/pi-vault/site.env. Do not edit."
    echo "table inet pivault"
    echo "delete table inet pivault"
    echo "table inet pivault {"
    echo "	chain input {"
    echo "		type filter hook input priority filter; policy drop;"
    echo "		ct state established,related accept"
    echo "		ct state invalid drop"
    echo "		iifname \"lo\" accept"
    echo "		ip protocol icmp accept"
    echo "		meta l4proto ipv6-icmp accept"
    echo "		udp sport 67 udp dport 68 accept"
    echo "		ip6 saddr fe80::/10 udp dport 546 accept"
    echo "		# Image builds run in a Docker network of their own and may ask this Pi for DNS."
    echo "		iifname \"docker0\" meta l4proto { tcp, udp } th dport 53 accept"
    echo "		iifname \"br-*\" meta l4proto { tcp, udp } th dport 53 accept"
    echo "		# Tailscale's own encrypted tunnel (WireGuard); it answers nobody without a key."
    echo "		udp dport 41641 accept"
    echo "		# The tailnet and the home network may reach SSH and the vault. Nobody else."
    echo "		iifname \"tailscale0\" tcp dport { $tcp } accept"
    echo "		ip saddr $LAN_CIDR tcp dport { $tcp$extra_tcp } accept"
    echo "		ip6 saddr { fe80::/10, fc00::/7${lan6:+, $lan6} } tcp dport { $tcp$extra_tcp } accept"
    echo "		ip saddr $LAN_CIDR udp dport 5353 accept"
    echo "		ip6 saddr fe80::/10 udp dport 5353 accept"
    [ -z "$extra_udp" ] || echo "		ip saddr $LAN_CIDR udp dport { $extra_udp } accept"
    echo "		counter drop"
    echo "	}"
    echo "}"
  } > /etc/pi-vault/firewall.nft
  chmod 600 /etc/pi-vault/firewall.nft
}

render_caddy() {
  local lan_sites="https://$LAN_IP" name ts_block=""
  for name in ${LAN_NAMES:-}; do lan_sites="$lan_sites, https://$name"; done
  if [ -n "${TS_NAME:-}" ]; then
    ts_block=$'\n# Tailnet address: a publicly trusted certificate, fetched from Tailscale on this Pi.\n'"https://$TS_NAME {"$'\n\timport vault\n}\n'
  fi
  local tmp; tmp=$(mktemp)
  while IFS= read -r line; do
    case $line in
      __TS_BLOCK__) printf '%s' "$ts_block" ;;
      *)
        line=${line//__HTTP_PORT__/${HTTP_PORT:-80}}
        line=${line//__HTTPS_PORT__/${HTTPS_PORT:-443}}
        line=${line//__BRAND__/$BRAND}
        line=${line//__LAN_CIDR__/$LAN_CIDR}
        line=${line//__LAN_SITES__/$lan_sites}
        printf '%s\n' "$line" ;;
    esac
  done < "$STACK/Caddyfile.tmpl" > "$tmp"
  install -m 644 "$tmp" "$STACK/Caddyfile"; rm -f "$tmp"
}

render_env() {
  cat > "$STACK/.env" <<EOF
VW_VERSION=$VW_VERSION
CADDY_VERSION=$CADDY_VERSION
VAULT_UID=$VAULT_UID
VAULT_GID=$VAULT_GID
EOF
  if [ ! -f "$STACK/vault.env" ]; then
    sed -e "s|__PRIMARY_URL__|$PRIMARY_URL|" -e "s|__BRAND__|$BRAND|g" "$STACK/vault.env.tmpl" > "$STACK/vault.env"
  else
    sed -i -e "s|^DOMAIN=.*|DOMAIN=$PRIMARY_URL|" \
           -e "s|^INVITATION_ORG_NAME=.*|INVITATION_ORG_NAME=$BRAND|" \
           -e "s|^SMTP_FROM_NAME=.*|SMTP_FROM_NAME=$BRAND|" "$STACK/vault.env"
  fi
  chmod 600 "$STACK/vault.env"
}

cmd_apply() {
  need_root; load_site
  say "writing firewall, Caddy and server settings"
  render_firewall; render_caddy; render_env
  nft -c -f /etc/pi-vault/firewall.nft || die "firewall rules do not parse; nothing was changed"
  systemctl restart pi-vault-firewall.service
  if ! docker image inspect "pi-vault/vault:$VW_VERSION" >/dev/null 2>&1; then
    say "building the branded image (a few minutes the first time)"
    compose build vault
  fi
  compose up -d --remove-orphans
  compose restart caddy >/dev/null
  wait_alive 8732 120 || die "the vault did not come up; see: vaultctl logs"
  cmd_status >/dev/null 2>&1 || true
  say "vault is up at $PRIMARY_URL"
}

image_stamp() { (cd "$STACK/image" && cat Dockerfile ./*.py ./*.env ./*.svg ./*.tmpl ./*.scss 2>/dev/null | sha256sum | cut -c1-16); }

cmd_build() {
  need_root; load_site; render_env
  compose build --pull vault
  mkdir -p "$STATE"; image_stamp > "$STATE/image.stamp"
}

cmd_build_if_changed() {  # rebuild only when the name, icon or rebrand script changed
  need_root; load_site
  if docker image inspect "pi-vault/vault:$VW_VERSION" >/dev/null 2>&1 \
     && [ "$(cat "$STATE/image.stamp" 2>/dev/null)" = "$(image_stamp)" ]; then
    say "branding unchanged; no rebuild needed"
  else
    cmd_build
  fi
}
cmd_logs() { need_root; compose logs --tail "${1:-80}"; }
cmd_restart() { need_root; compose restart; }

# ------------------------------------------------------------------ people

cmd_signup_window() {
  need_root; load_site
  local minutes=${1:-15}
  sed -i 's|^SIGNUPS_ALLOWED=.*|SIGNUPS_ALLOWED=true|' "$STACK/vault.env"
  compose up -d vault >/dev/null
  systemctl stop pi-vault-signups-off.timer 2>/dev/null || true
  systemd-run --quiet --unit pi-vault-signups-off --on-active="${minutes}m" /usr/local/sbin/vaultctl signups-off
  say "sign-up is open for $minutes minutes at $PRIMARY_URL/#/signup, then closes by itself"
}

cmd_signups_off() {
  need_root
  sed -i 's|^SIGNUPS_ALLOWED=.*|SIGNUPS_ALLOWED=false|' "$STACK/vault.env"
  compose up -d vault >/dev/null
  say "sign-up is closed"
}

cmd_admin_on() {
  need_root; load_site
  [ -t 0 ] || die "run this in a terminal: you type the admin password yourself"
  command -v argon2 >/dev/null || die "argon2 is missing (apt-get install argon2)"
  local first second hash
  read -rs -p "Admin password (not shown): " first; echo
  read -rs -p "Again: " second; echo
  [ -n "$first" ] && [ "$first" = "$second" ] || die "the two entries differ; nothing changed"
  [ "${#first}" -ge 12 ] || die "use at least 12 characters; nothing changed"
  # Only this argon2id hash is stored; the password itself is never written anywhere.
  hash=$(printf '%s' "$first" | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4)
  unset first second
  case $hash in '$argon2id$'*) ;; *) die "hashing failed; nothing changed" ;; esac
  sed -i '/^ADMIN_TOKEN=/d' "$STACK/vault.env"
  printf "ADMIN_TOKEN='%s'\n" "$hash" >> "$STACK/vault.env"
  compose up -d vault >/dev/null
  say "admin page is on: $PRIMARY_URL/admin   (turn it off again with: vaultctl admin-off)"
}

cmd_admin_off() {
  need_root
  sed -i '/^ADMIN_TOKEN=/d' "$STACK/vault.env"
  compose up -d vault >/dev/null
  say "admin page is off"
}

# ------------------------------------------------------------------ tailscale

cmd_tailscale() {
  need_root; load_site
  command -v tailscale >/dev/null || die "tailscale is not installed (bootstrap.sh installs it)"
  if ! tailscale status --json 2>/dev/null | jq -e '.BackendState == "Running"' >/dev/null; then
    # Signing in happens in a browser, maybe on another device: ask in the background, show the link.
    systemctl stop pi-vault-tailscale-up >/dev/null 2>&1 || true
    systemctl reset-failed pi-vault-tailscale-up >/dev/null 2>&1 || true
    systemd-run --quiet --unit pi-vault-tailscale-up --collect \
      tailscale up --ssh=false --accept-dns=false --accept-routes=false --hostname="${TS_HOSTNAME:-vault}"
    local url="" left=30
    while [ -z "$url" ] && [ "$left" -gt 0 ]; do
      sleep 1; left=$((left - 1))
      tailscale status --json 2>/dev/null | jq -e '.BackendState == "Running"' >/dev/null && break
      url=$(tailscale status --json 2>/dev/null | jq -r '.AuthURL // empty')
    done
    if [ -n "$url" ]; then
      say "sign this Pi in to your tailnet: open $url"
      say "then turn on MagicDNS and HTTPS Certificates (admin console, DNS page) and run: vaultctl tailscale"
      return 0
    fi
    tailscale status --json 2>/dev/null | jq -e '.BackendState == "Running"' >/dev/null \
      || die "Tailscale gave no sign-in link; see: journalctl -u pi-vault-tailscale-up"
  fi
  local name; name=$(tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//')
  [ -n "$name" ] && [ "$name" != null ] || die "no tailnet name yet (is MagicDNS on in the Tailscale admin console?)"
  if ! tailscale cert --cert-file /dev/null --key-file /dev/null "$name" >/dev/null 2>&1; then
    die "Tailscale would not issue a certificate for $name: turn on 'HTTPS Certificates' in the admin console (DNS page), then run this again"
  fi
  set_site TS_NAME "$name"
  say "tailnet name: $name"
  cmd_apply
}

# ------------------------------------------------------------------ backup

cmd_backup() {
  need_root; load_site
  grep -q '^age1' "$RECIPIENTS" 2>/dev/null || die "no backup key yet: put the age public key in $RECIPIENTS"
  mkdir -p "$BACKUPS" "$STATE"; chmod 700 "$BACKUPS"
  local stamp work out
  stamp=$(date +%Y%m%d-%H%M%S)
  work=$(mktemp -d "$BACKUPS/.work.XXXXXX")
  WORK=$work
  trap 'rm -rf "$WORK" "$DATA/.backup-copy.sqlite3"' EXIT
  mkdir -p "$work/data" "$work/config" "$work/caddy"

  # Database: a consistent copy taken while the server keeps running. It is made as the
  # server's own user (so the live database files never change owner), then moved here.
  rm -f "$DATA/.backup-copy.sqlite3"
  runuser -u pivault -- sqlite3 "$DATA/db.sqlite3" ".timeout 30000" ".backup '$DATA/.backup-copy.sqlite3'"
  mv "$DATA/.backup-copy.sqlite3" "$work/data/db.sqlite3"
  [ "$(dbq "$work/data/db.sqlite3" 'PRAGMA integrity_check;')" = ok ] \
    || die "the database copy failed its integrity check; no backup written"

  local item
  for item in attachments sends rsa_key.pem rsa_key.pub.pem config.json; do
    [ ! -e "$DATA/$item" ] || cp -a "$DATA/$item" "$work/data/"
  done
  cp -a "$SITE" "$STACK/vault.env" "$STACK/image/brand.env" "$work/config/"
  [ ! -d /srv/pi-vault/caddy/data/caddy/pki ] || cp -a /srv/pi-vault/caddy/data/caddy/pki "$work/caddy/"

  local db="$work/data/db.sqlite3"
  rm -f "$db-wal" "$db-shm"
  jq -n \
    --arg created "$(date -Is)" --arg host "$(hostname)" --arg version "$VW_VERSION" \
    --argjson users "$(dbq "$db" 'select count(*) from users')" \
    --argjson ciphers "$(dbq "$db" 'select count(*) from ciphers')" \
    --argjson attachments "$(dbq "$db" 'select count(*) from attachments')" \
    --argjson files "$(find "$work/data" -type f | wc -l)" \
    '{created:$created, host:$host, version:$version, users:$users, ciphers:$ciphers, attachments:$attachments, files:$files}' \
    > "$work/manifest.json"

  out="$BACKUPS/vault-$stamp.tar.zst.age"
  tar -C "$work" -cf - manifest.json data config caddy | zstd -q -10 | age -R "$RECIPIENTS" -o "$out.partial"
  mv "$out.partial" "$out"; chmod 600 "$out"

  ls -1t "$BACKUPS"/vault-*.tar.zst.age | tail -n +$((KEEP_LOCAL + 1)) | xargs -r rm -f
  jq -n --arg when "$(date -Is)" --arg file "$(basename "$out")" --argjson bytes "$(stat -c %s "$out")" \
    '{when:$when, file:$file, bytes:$bytes}' > "$STATE/backup.json"
  rm -rf "$work"; trap - EXIT
  say "backup written: $out ($(stat -c %s "$out") bytes)"
}

unpack_plain() {  # unpack_plain DIR   (stdin: the decrypted .tar.zst)
  local dir=$1
  rm -rf "$dir"; mkdir -p "$dir"; chmod 700 "$dir"
  zstd -dc | tar -C "$dir" -xf -
  [ -f "$dir/manifest.json" ] && [ -f "$dir/data/db.sqlite3" ] || die "this is not a vault backup"
  rm -f "$dir/data/db.sqlite3-wal" "$dir/data/db.sqlite3-shm"
  [ "$(dbq "$dir/data/db.sqlite3" 'PRAGMA integrity_check;')" = ok ] || die "restored database is damaged"
  local key want got
  for key in users ciphers attachments; do
    want=$(jq -r ".$key" "$dir/manifest.json")
    got=$(dbq "$dir/data/db.sqlite3" "select count(*) from $key")
    [ "$want" = "$got" ] || die "$key: backup says $want, restored database has $got"
  done
  [ -f "$dir/data/rsa_key.pem" ] || die "the server key (rsa_key.pem) is missing from the backup"
}

cmd_restore_test() {
  need_root; load_site
  [ ! -t 0 ] || die "pipe a decrypted backup into this (the Mac's restore-test.sh does it)"
  local dir=/var/tmp/pi-vault-restore-test name=pi-vault-restore-test port=18732
  mkdir -p "$STATE"
  DRILL_DIR=$dir; DRILL_NAME=$name; DRILL_RESULT=failed
  finish() {
    docker rm -f "$DRILL_NAME" >/dev/null 2>&1 || true
    local manifest='{}'; [ ! -f "$DRILL_DIR/manifest.json" ] || manifest=$(cat "$DRILL_DIR/manifest.json")
    rm -rf "$DRILL_DIR"
    jq -n --arg when "$(date -Is)" --arg result "$DRILL_RESULT" --argjson backup "$manifest" \
      '{when:$when, result:$result, backup:$backup}' > "$STATE/restore-test.json"
  }
  trap finish EXIT
  unpack_plain "$dir"
  chown -R pivault: "$dir/data"
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run -d --name "$name" --network host --user "$VAULT_UID:$VAULT_GID" \
    --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges:true \
    -e ROCKET_ADDRESS=127.0.0.1 -e ROCKET_PORT=$port -e DATA_FOLDER=/data \
    -e DOMAIN="http://127.0.0.1:$port" -e SIGNUPS_ALLOWED=false \
    -v "$dir/data:/data" "pi-vault/vault:$VW_VERSION" >/dev/null
  wait_alive $port 90 || { docker logs --tail 30 "$name" >&2; die "a server started on the restored data did not come up"; }
  curl -fsS -m 5 "http://127.0.0.1:$port/api/config" | jq -e '.version' >/dev/null \
    || die "the restored server does not answer its API"
  curl -fsS -m 5 "http://127.0.0.1:$port/" | grep -qF "$BRAND" || die "the restored server does not serve the web vault"
  DRILL_RESULT=ok
  say "restore test passed: $(jq -c . "$dir/manifest.json")"
}

cmd_restore() {
  need_root; load_site
  [ "${1:-}" = "--replace-live" ] || die "this replaces the live vault. Run: vaultctl restore --replace-live < decrypted-backup"
  [ ! -t 0 ] || die "pipe a decrypted backup into this"
  local dir=/srv/pi-vault/restore-incoming stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  unpack_plain "$dir"
  say "stopping the vault"
  compose down
  [ ! -d "$DATA" ] || mv "$DATA" "/srv/pi-vault/data.replaced-$stamp"
  mv "$dir/data" "$DATA"; chown -R pivault: "$DATA"; chmod 700 "$DATA"
  if [ -d "$dir/caddy/pki" ]; then
    mkdir -p /srv/pi-vault/caddy/data/caddy
    [ ! -d /srv/pi-vault/caddy/data/caddy/pki ] || mv /srv/pi-vault/caddy/data/caddy/pki "/srv/pi-vault/caddy/pki.replaced-$stamp"
    mv "$dir/caddy/pki" /srv/pi-vault/caddy/data/caddy/pki
  fi
  [ -f "$STACK/vault.env" ] || install -m 600 "$dir/config/vault.env" "$STACK/vault.env"
  rm -rf "$dir"
  cmd_apply
  say "restored. The previous data is kept at /srv/pi-vault/data.replaced-$stamp (delete it yourself when sure)"
}

# ------------------------------------------------------------------ update

cmd_update() {
  need_root; load_site
  mkdir -p "$STATE"
  local latest note="" old=$VW_VERSION
  latest=$(curl -fsS -m 20 https://api.github.com/repos/dani-garcia/vaultwarden/releases/latest | jq -r '.tag_name // empty') || latest=""
  if [ -z "$latest" ]; then
    note="could not look up the latest release"
  elif [ "$latest" = "$old" ]; then
    note="up to date"
  else
    say "new server release $latest (running $old)"
    if ! (cd "$STACK" && VW_VERSION=$latest docker compose build --pull vault); then
      note="release $latest is out, but building it failed (still running $old): see journalctl -u pi-vault-update"
    else
      if grep -q '^age1' "$RECIPIENTS" 2>/dev/null; then cmd_backup; fi
      mkdir -p /srv/pi-vault/rollback; chmod 700 /srv/pi-vault/rollback
      runuser -u pivault -- sqlite3 "$DATA/db.sqlite3" ".timeout 30000" ".backup '$DATA/db.pre-update.sqlite3'"
      mv "$DATA/db.pre-update.sqlite3" "/srv/pi-vault/rollback/db-before-$latest.sqlite3"
      set_site VW_VERSION "$latest"; VW_VERSION=$latest; render_env
      compose up -d vault
      if wait_alive 8732 180; then
        note="updated $old -> $latest"
        find /srv/pi-vault/rollback -name 'db-before-*' ! -name "db-before-$latest.sqlite3" -delete
      else
        say "release $latest did not start; going back to $old"
        compose stop vault
        set_site VW_VERSION "$old"; VW_VERSION=$old; render_env
        install -o pivault -g pivault -m 600 "/srv/pi-vault/rollback/db-before-$latest.sqlite3" "$DATA/db.sqlite3"
        rm -f "$DATA/db.sqlite3-wal" "$DATA/db.sqlite3-shm"
        compose up -d vault
        wait_alive 8732 180 && note="release $latest failed to start; rolled back to $old" \
          || note="release $latest failed AND the rollback to $old did not start: needs attention"
      fi
    fi
  fi
  compose pull -q caddy 2>/dev/null && compose up -d caddy >/dev/null 2>&1 || true
  docker image prune -f >/dev/null 2>&1 || true
  jq -n --arg when "$(date -Is)" --arg note "$note" --arg running "$VW_VERSION" --arg latest "${latest:-unknown}" \
    '{when:$when, note:$note, running:$running, latest:$latest}' > "$STATE/update.json"
  say "$note"
}

# ------------------------------------------------------------------ misc

cmd_status() { need_root; python3 "$ROOT/pi/status.py" "$@"; }

cmd_confirm() {
  need_root
  systemctl stop pi-vault-guard.timer >/dev/null 2>&1 || true
  say "firewall and SSH settings are kept"
}

cmd_ca() {
  local cert=/srv/pi-vault/caddy/data/caddy/pki/authorities/local/root.crt
  [ -f "$cert" ] || die "no local certificate authority yet (it appears once Caddy has started)"
  cat "$cert"
}

usage() {
  cat <<'EOF'
vaultctl <command>

  status            health summary (also written to the /status/ page)
  apply             re-read /etc/pi-vault/site.env, rewrite firewall + Caddy + settings, restart
  build             rebuild the branded image (after changing the name or icon)
  logs [n]          last lines of the server and Caddy logs
  restart           restart both containers

  signup-window [m] open sign-up for m minutes (default 15), then close it again
  signups-off       close sign-up now
  admin-on          turn the admin page on (you type a password; only its argon2 hash is kept)
  admin-off         turn the admin page off

  tailscale         join the tailnet / pick up the tailnet name and certificate
  ca                print the local certificate authority's root certificate

  backup            write an encrypted backup now
  restore-test      (stdin: decrypted backup) start a throw-away server on it and check it
  restore --replace-live   (stdin: decrypted backup) replace the live vault; old data is kept aside
  update            update the server if a new release is out (backs up first, rolls back on failure)
EOF
}

case "${1:-}" in
  apply) cmd_apply ;;
  build) cmd_build ;;
  build-if-changed) cmd_build_if_changed ;;
  stamp) need_root; mkdir -p "$STATE"; image_stamp > "$STATE/image.stamp" ;;
  logs) shift; cmd_logs "$@" ;;
  restart) cmd_restart ;;
  signup-window) shift; cmd_signup_window "$@" ;;
  signups-off) cmd_signups_off ;;
  admin-on) cmd_admin_on ;;
  admin-off) cmd_admin_off ;;
  tailscale) cmd_tailscale ;;
  ca) cmd_ca ;;
  confirm) cmd_confirm ;;
  backup) cmd_backup ;;
  restore-test) cmd_restore_test ;;
  restore) shift; cmd_restore "$@" ;;
  update) cmd_update ;;
  status) shift; cmd_status "$@" ;;
  *) usage ;;
esac
