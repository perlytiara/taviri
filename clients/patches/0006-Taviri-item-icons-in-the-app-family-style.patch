+import { CipherType } from "../enums";
+import { CipherView } from "../models/view/cipher.view";
+
+import { buildCipherIcon } from "./build-cipher-icon";
+import { TAVIRI_ICON_PACK } from "./taviri-icon-pack";
+import {
+  isTaviriFieldName,
+  parseTaviriIconValue,
+  taviriFallbackImage,
+  taviriIconFieldValue,
+  taviriPackImage,
+} from "./taviri-item-icon";
+
+const ICONS = "https://icons.example";
+const pack = (id: string) => TAVIRI_ICON_PACK[id].image;
+
+function item(type: CipherType, extra: Record<string, unknown> = {}): CipherView {
+  return { type, fields: [], ...extra } as any as CipherView;
+}
+const withIcon = (
+  value: string,
+  type: CipherType = CipherType.Login,
+  extra: Record<string, unknown> = {},
+) => item(type, { ...extra, fields: [{ name: "taviri:icon", value }] });
+
+describe("Taviri item icons", () => {
+  const brand = process.env.SMARTFILL_BRAND_NAME;
+  afterEach(() => {
+    if (brand === undefined) {
+      delete process.env.SMARTFILL_BRAND_NAME;
+    } else {
+      process.env.SMARTFILL_BRAND_NAME = brand;
+    }
+  });
+
+  it("ships the family's app icons and the item glyphs as PNG data URLs", () => {
+    for (const id of ["vault", "relay", "archive", "note", "terminal", "wifi", "card", "user"]) {
+      expect(TAVIRI_ICON_PACK[id].image).toMatch(/^data:image\/png;base64,[A-Za-z0-9+/]+=*$/);
+    }
+    expect(taviriPackImage("nope")).toBeNull();
+    expect(taviriPackImage("constructor")).toBeNull();
+  });
+
+  it.each([
+    ["vault", { kind: "pack", id: "vault" }],
+    [" Pack:Note ", { kind: "pack", id: "note" }],
+    ["WIFI", { kind: "pack", id: "wifi" }],
+    ["github.com", { kind: "site", hostname: "github.com" }],
+    ["https://GitHub.com/login?x=1", { kind: "site", hostname: "github.com" }],
+    ["none", { kind: "none" }],
+    ["pack:nope", null],
+    ["hello", null],
+    ["", null],
+    ["javascript:alert(1)", null],
+  ])("reads %j", (value, expected) => {
+    expect(parseTaviriIconValue(value)).toEqual(expected);
+  });
+
+  it("finds the field whatever its case, in full and list views", () => {
+    expect(taviriIconFieldValue(withIcon("relay"))).toBe("relay");
+    expect(
+      taviriIconFieldValue({
+        type: { secureNote: {} },
+        fields: [{ name: " Taviri:Icon ", value: "note" }],
+      } as any),
+    ).toBe("note");
+    expect(isTaviriFieldName("taviri:icon")).toBe(true);
+    expect(isTaviriFieldName("grokbot:recipe")).toBe(false);
+  });
+
+  it("a pack icon shows even with website icons off, and replaces the favicon", () => {
+    const cipher = withIcon("vault", CipherType.Login, { login: { uri: "https://test.example" } });
+    expect(buildCipherIcon(ICONS, cipher, true)).toEqual({
+      imageEnabled: true,
+      image: pack("vault"),
+      fallbackImage: "",
+      icon: "bwi-globe",
+    });
+    expect(buildCipherIcon(null, cipher, false).image).toBe(pack("vault"));
+  });
+
+  it("a website gives that site's icon, only when website icons are on", () => {
+    const note = withIcon("github.com", CipherType.SecureNote);
+    expect(buildCipherIcon(ICONS, note, true)).toEqual({
+      imageEnabled: true,
+      image: "https://icons.example/github.com/icon.png",
+      fallbackImage: "images/bwi-globe.png",
+      icon: "bwi-sticky-note",
+    });
+    expect(buildCipherIcon(ICONS, note, false)).toEqual({
+      imageEnabled: false,
+      image: null,
+      fallbackImage: "",
+      icon: "bwi-sticky-note",
+    });
+  });
+
+  it("none drops the favicon", () => {
+    const cipher = withIcon("none", CipherType.Login, { login: { uri: "https://test.example" } });
+    expect(buildCipherIcon(ICONS, cipher, true)).toEqual({
+      imageEnabled: true,
+      image: null,
+      fallbackImage: "",
+      icon: "bwi-globe",
+    });
+  });
+
+  it("only a pack image counts as a fallback picture", () => {
+    expect(taviriFallbackImage(null)).toBeNull();
+    expect(
+      taviriFallbackImage({
+        imageEnabled: true,
+        image: null,
+        fallbackImage: "images/bwi-globe.png",
+        icon: "bwi-globe",
+      }),
+    ).toBeNull();
+  });
+
+  it("an unbranded build without the field draws what upstream draws", () => {
+    delete process.env.SMARTFILL_BRAND_NAME;
+    expect(buildCipherIcon(ICONS, item(CipherType.SecureNote), true)).toEqual({
+      imageEnabled: true,
+      image: null,
+      fallbackImage: "",
+      icon: "bwi-sticky-note",
+    });
+  });
+
+  describe("branded build", () => {
+    beforeEach(() => {
+      process.env.SMARTFILL_BRAND_NAME = "Taviri";
+    });
+
+    it.each([
+      [CipherType.SecureNote, {}, "note"],
+      [CipherType.SshKey, {}, "terminal"],
+      [CipherType.Identity, {}, "identity"],
+      [CipherType.Card, { card: {} }, "card"],
+      [CipherType.Login, { login: {} }, "user"],
+      [CipherType.Login, { login: { uri: "androidapp://com.example.app" } }, "phone"],
+    ])("type %s gets a pack icon", (type, extra, id) => {
+      expect(buildCipherIcon(ICONS, item(type, extra), true).image).toBe(pack(id));
+      expect(buildCipherIcon(null, item(type, extra), false).image).toBe(pack(id));
+    });
+
+    it("keeps a website's own icon and the card network's artwork", () => {
+      const site = item(CipherType.Login, { login: { uri: "https://test.example" } });
+      expect(buildCipherIcon(ICONS, site, true).image).toBe(
+        "https://icons.example/test.example/icon.png",
+      );
+      expect(buildCipherIcon(ICONS, site, true).fallbackImage).toBe(pack("globe"));
+      expect(taviriFallbackImage(buildCipherIcon(ICONS, site, true))).toBe(pack("globe"));
+      expect(buildCipherIcon(ICONS, site, false).image).toBe(pack("globe"));
+      const none = withIcon("none", CipherType.Login, { login: { uri: "https://test.example" } });
+      expect(buildCipherIcon(ICONS, none, true).image).toBe(pack("globe"));
+      const note = withIcon("github.com", CipherType.SecureNote);
+      expect(buildCipherIcon(ICONS, note, true)).toMatchObject({
+        image: "https://icons.example/github.com/icon.png",
+        fallbackImage: pack("note"),
+      });
+      const visa = item(CipherType.Card, { card: { brand: "Visa" } });
+      expect(buildCipherIcon(ICONS, visa, true)).toEqual({
+        imageEnabled: true,
+        image: null,
+        fallbackImage: "",
+        icon: "credit-card-icon card-visa",
+      });
+    });
+
+    it("the item's own choice still wins", () => {
+      const site = withIcon("relay", CipherType.Login, { login: { uri: "https://test.example" } });
+      expect(buildCipherIcon(ICONS, site, true).image).toBe(pack("relay"));
+    });
+  });
+});
