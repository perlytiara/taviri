@@ -0,0 +1,10 @@
+/**
+ * Taviri fork — the custom fields that hold Taviri's own settings for an item (`taviri:icon`…).
+ * Kept apart from the icon pack so page scripts can check a field name without loading the pack.
+ */
+export const TAVIRI_ICON_FIELD = "taviri:icon";
+
+/** Whether a custom field name is one of Taviri's own settings (`taviri:…`), never typed into pages. */
+export function isTaviriFieldName(name: unknown): boolean {
+  return typeof name === "string" && name.trim().toLowerCase().startsWith("taviri:");
+}
