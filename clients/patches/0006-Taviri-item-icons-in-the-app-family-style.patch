+++ b/libs/common/src/vault/icon/taviri-item-icon.ts
@@ -0,0 +1,165 @@
+/**
+ * Taviri fork — item icons.
+ *
+ * An item picks its icon with a text custom field named `taviri:icon`. The field travels with the
+ * item, so every Taviri app (extension, desktop, Android) shows the same icon:
+ *
+ * - `vault`, `note`, `wifi`… (or `pack:<id>`): an icon from the Taviri icon pack
+ *   (`taviri-icon-pack.ts`), drawn in the owner's app family style and shipped inside the app, so
+ *   it shows without a network request, even with website icons turned off;
+ * - `github.com` or `https://github.com/…`: that website's icon, for items without a website or
+ *   whose website has a poor icon (only when website icons are on);
+ * - `none`: not the website's icon, the type's icon.
+ *
+ * A branded build also gives the items that have no website icon a pack icon for their type
+ * (notes, SSH keys, cards, identities…) instead of the font icon, and shows that icon while a
+ * website icon loads or when the site has none.
+ */
+import { Utils } from "../../platform/misc/utils";
+import { CipherType } from "../enums/cipher-type";
+import { CipherViewLike, CipherViewLikeUtils } from "../utils/cipher-view-like-utils";
+
+import type { CipherIconDetails } from "./build-cipher-icon";
+import { TAVIRI_ICON_FIELD } from "./taviri-fields";
+import { TAVIRI_ICON_PACK } from "./taviri-icon-pack";
+
+export { TAVIRI_ICON_FIELD, isTaviriFieldName } from "./taviri-fields";
+
+export type TaviriIconChoice =
+  { kind: "pack"; id: string } | { kind: "site"; hostname: string } | { kind: "none" };
+
+/** Whether this build carries the Taviri brand (the browser build defines the name). */
+function taviriBrandedBuild(): boolean {
+  try {
+    return !!process.env.SMARTFILL_BRAND_NAME;
+  } catch {
+    // No `process` at all: an unbranded build.
+    return false;
+  }
+}
+
+export function taviriPackImage(id: string): string | null {
+  return Object.prototype.hasOwnProperty.call(TAVIRI_ICON_PACK, id)
+    ? TAVIRI_ICON_PACK[id].image
+    : null;
+}
+
+/** Reads a `taviri:icon` value; `null` when it is empty or names nothing usable. */
+export function parseTaviriIconValue(value: unknown): TaviriIconChoice | null {
+  if (typeof value !== "string" || !value.trim()) {
+    return null;
+  }
+  const text = value.trim();
+  const lower = text.toLowerCase();
+  if (lower === "none") {
+    return { kind: "none" };
+  }
+  const isPackRef = lower.startsWith("pack:");
+  const id = isPackRef ? lower.slice("pack:".length).trim() : lower;
+  if (taviriPackImage(id)) {
+    return { kind: "pack", id };
+  }
+  if (isPackRef || !text.includes(".")) {
+    return null;
+  }
+  const hostname = Utils.getHostname(text.includes("://") ? text : `https://${text}`);
+  if (!hostname || !hostname.includes(".") || !/^[a-z0-9.-]+$/i.test(hostname)) {
+    return null;
+  }
+  return { kind: "site", hostname: hostname.toLowerCase() };
+}
+
+/** The item's `taviri:icon` value, if it has one. */
+export function taviriIconFieldValue(cipher: CipherViewLike): string | undefined {
+  const fields = CipherViewLikeUtils.getFields(cipher);
+  if (!Array.isArray(fields)) {
+    return undefined;
+  }
+  const field = fields.find(
+    (f) => typeof f?.name === "string" && f.name.trim().toLowerCase() === TAVIRI_ICON_FIELD,
+  );
+  return field?.value ?? undefined;
+}
+
+/** The pack icon a branded build gives an item that has no website icon. */
+export function taviriTypeIconId(type: CipherType, uri: string | undefined): string | null {
+  switch (type) {
+    case CipherType.Login:
+      if (!uri) {
+        return "user";
+      }
+      return /^(androidapp|iosapp):\/\//i.test(uri) ? "phone" : "globe";
+    case CipherType.SecureNote:
+      return "note";
+    case CipherType.SshKey:
+      return "terminal";
+    case CipherType.Card:
+      return "card";
+    case CipherType.Identity:
+    case CipherType.Passport:
+    case CipherType.DriversLicense:
+      return "identity";
+    case CipherType.BankAccount:
+      return "bank";
+    default:
+      return null;
+  }
+}
+
+const packIcon = (details: CipherIconDetails, id: string): CipherIconDetails => ({
+  ...details,
+  imageEnabled: true,
+  image: taviriPackImage(id),
+  fallbackImage: "",
+});
+
+/**
+ * Applies the item's `taviri:icon` choice, then (branded builds) the pack's type icons, to the icon
+ * upstream chose. A website icon is kept unless the item asks for another; in a branded build the
+ * type's pack icon comes with it as `fallbackImage`, shown while it loads or when the site has none.
+ */
+export function applyTaviriItemIcon(
+  details: CipherIconDetails,
+  cipher: CipherViewLike,
+  iconsServerUrl: string | null,
+  showFavicon: boolean,
+): CipherIconDetails {
+  const choice = parseTaviriIconValue(taviriIconFieldValue(cipher));
+  if (choice?.kind === "pack") {
+    return packIcon(details, choice.id);
+  }
+  if (choice?.kind === "none") {
+    details = { ...details, image: null, fallbackImage: "" };
+  }
+  if (choice?.kind === "site" && showFavicon && iconsServerUrl) {
+    details = {
+      ...details,
+      imageEnabled: true,
+      image: `${iconsServerUrl}/${choice.hostname}/icon.png`,
+      fallbackImage: "images/bwi-globe.png",
+    };
+  }
+
+  if (!taviriBrandedBuild()) {
+    return details;
+  }
+  const typeId = taviriTypeIconId(
+    CipherViewLikeUtils.getType(cipher),
+    CipherViewLikeUtils.uri(cipher),
+  );
+  if (details.imageEnabled && details.image) {
+    const fallback = typeId ? taviriPackImage(typeId) : null;
+    return fallback ? { ...details, fallbackImage: fallback } : details;
+  }
+  if (details.icon.startsWith("credit-card-icon")) {
+    // The card network's own artwork (Visa, Mastercard…) says more than a generic card.
+    return details;
+  }
+  return typeId ? packIcon(details, typeId) : details;
+}
+
+/** The pack image to show while a website icon loads or when it fails (branded builds), if any. */
+export function taviriFallbackImage(details: CipherIconDetails | null | undefined): string | null {
+  const fallback = details?.fallbackImage;
+  return fallback && fallback.startsWith("data:image/png;base64,") ? fallback : null;
+}
