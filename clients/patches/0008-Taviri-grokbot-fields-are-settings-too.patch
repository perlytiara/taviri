 }
+
+/**
+ * Whether a custom field holds a setting rather than a value for pages: Taviri's own (`taviri:…`)
+ * or the Grok Bot connector's first names (`grokbot:…`). Neither is ever typed into a page, the
+ * same rule as the Taviri connector.
+ */
+export function isSettingFieldName(name: unknown): boolean {
+  if (typeof name !== "string") {
+    return false;
+  }
+  const folded = name.trim().toLowerCase();
+  return folded.startsWith("taviri:") || folded.startsWith("grokbot:");
+}
