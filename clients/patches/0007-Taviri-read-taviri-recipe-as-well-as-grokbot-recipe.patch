+  return SMARTFILL_RECIPE_FIELD_NAMES.includes(smartfillFoldText(name));
+}
+
+/**
+ * The recipe field to use: among the recipe fields that have a value, `taviri:recipe` first, else
+ * the first one. Same choice as the connector's `itemRecipe`.
+ */
+export function smartfillRecipeField(
+  cipher: CipherView | null | undefined,
+): { name?: string | null; value?: string | null } | undefined {
+  const withValue = (cipher?.fields ?? []).filter(
+    (f) => f && isSmartfillRecipeFieldName(f.name) && String(f.value ?? "").trim(),
+  );
+  return (
+    withValue.find((f) => smartfillFoldText(f.name) === SMARTFILL_RECIPE_FIELD_NAME) ?? withValue[0]
+  );
 }
 
