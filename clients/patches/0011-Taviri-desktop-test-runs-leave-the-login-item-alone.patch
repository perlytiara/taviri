From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: owner <owner@localhost>
Date: Sat, 14 Nov 2026 23:51:09 +0100
Subject: [PATCH 11/11] Taviri desktop: test runs leave the login item alone

On every start Bitwarden re-applies "Start automatically on login" (on by
default), so each test run with a fresh data folder registered the real
app as a login item. With its own data folder (BITWARDEN_APPDATA_DIR) the
fork now leaves the login item to the installed app.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/src/main/messaging.main.ts | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/main/messaging.main.ts b/apps/desktop/src/main/messaging.main.ts
index 4352f2e..6ac2e0c 100644
--- a/apps/desktop/src/main/messaging.main.ts
+++ b/apps/desktop/src/main/messaging.main.ts
@@ -7,6 +7,7 @@ import { autostart } from "@bitwarden/desktop-napi";
 
 import { Main } from "../main";
 import { DesktopSettingsService } from "../platform/services/desktop-settings.service";
+import { taviriBrand } from "../taviri/brand";
 
 import { MenuUpdateRequest } from "./menu/menu.updater";
 
@@ -26,8 +27,13 @@ export class MessagingMain {
 
     // On app start, regenerate the configurations needed to autostart or not auto-start
     // depending on the setting provided in the settings file.
-    const openAtLogin = await firstValueFrom(this.desktopSettingsService.openAtLogin$);
-    this.setOpenAtLogin(openAtLogin);
+    // Taviri fork: the login item belongs to the installed app, not to a data folder. A run with
+    // its own data folder (BITWARDEN_APPDATA_DIR, as the tests use) leaves it alone, so a test
+    // never turns "open at login" on or off for the real app.
+    if (taviriBrand == null || process.env.BITWARDEN_APPDATA_DIR == null) {
+      const openAtLogin = await firstValueFrom(this.desktopSettingsService.openAtLogin$);
+      this.setOpenAtLogin(openAtLogin);
+    }
 
     ipcMain.on(
       "messagingService",
