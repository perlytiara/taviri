@@ -0,0 +1,32 @@
+/**
+ * Taviri fork — drawn from the brand kit (`brand/` in the Taviri repository, placeholder artwork until the
+ * owner approves it). Used instead of Bitwarden's artwork when the build is branded: webpack swaps
+ * the module in (see `webpack/smartfill-brand`). Colours come from the theme, which the build
+ * recolours from Bitwarden blue to the brand colour.
+ */
+import { css } from "@emotion/css";
+import { html } from "lit";
+
+import { IconProps } from "../../content/components/common-types";
+import { buildIconColorRule, ruleNames, themes } from "../../content/components/constants/styles";
+
+/** The mark in the notification bar, in place of the content scripts' `Shield`. */
+export function Shield({ ariaHidden = true, color, theme }: IconProps) {
+  const shapeColor = color || themes[theme].brandLogo;
+
+  return html`
+    <svg
+      xmlns="http://www.w3.org/2000/svg"
+      viewBox="0 0 64 64"
+      fill="none"
+      aria-hidden="${ariaHidden}"
+    >
+      <path
+        class=${css(buildIconColorRule(shapeColor, ruleNames.fill))}
+        fill-rule="evenodd"
+        clip-rule="evenodd"
+        d="M15 0h34a15 15 0 0 1 15 15v34a15 15 0 0 1-15 15H15A15 15 0 0 1 0 49V15A15 15 0 0 1 15 0ZM27.8 35.08A10 10 0 1 1 36.2 35.08L40 48H24Z"
+      />
+    </svg>
+  `;
+}
