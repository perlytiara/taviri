+/**
+ * Smartfill fork (Taviri): turns Bitwarden's blues into the brand colour.
+ *
+ * Every saturated blue is rotated to the brand hue in OKLCH, keeping its lightness, so light tints
+ * stay light and dark shades stay dark (the same rule as the Taviri web vault and Android app).
+ * Chroma is kept, then lowered until the colour fits in sRGB. Neutral, slightly bluish greys are
+ * left alone. Works on CSS and JS text: `#rrggbb`, `rgb()/rgba()` with commas, and the
+ * `--name: r g b;` triplets of Bitwarden's Tailwind theme.
+ */
+
+const clamp01 = (x) => Math.min(1, Math.max(0, x));
+const toLinear = (c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+const toGamma = (c) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);
+
+function rgbToOklch(r8, g8, b8) {
+  const r = toLinear(r8 / 255);
+  const g = toLinear(g8 / 255);
+  const b = toLinear(b8 / 255);
+  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+  const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
+  const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
+  const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
+  const C = Math.sqrt(A * A + B * B);
+  let h = (Math.atan2(B, A) * 180) / Math.PI;
+  if (h < 0) {
+    h += 360;
+  }
+  return { L, C, h };
+}
+
+function oklchToLinearRgb(L, C, h) {
+  const A = C * Math.cos((h * Math.PI) / 180);
+  const B = C * Math.sin((h * Math.PI) / 180);
+  const l = (L + 0.3963377774 * A + 0.2158037573 * B) ** 3;
+  const m = (L - 0.1055613458 * A - 0.0638541728 * B) ** 3;
+  const s = (L - 0.0894841775 * A - 1.291485548 * B) ** 3;
+  return [
+    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+    -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
+  ];
+}
+
+function oklchToRgb(L, C, h) {
+  let chroma = C;
+  let linear = oklchToLinearRgb(L, chroma, h);
+  // Lower the chroma until the colour is displayable.
+  for (let step = 0; step < 60 && linear.some((c) => c < -0.0001 || c > 1.0001); step++) {
+    chroma *= 0.95;
+    linear = oklchToLinearRgb(L, chroma, h);
+  }
+  return linear.map((c) => Math.round(clamp01(toGamma(clamp01(c))) * 255));
+}
+
+/** The brand colour's hue, from `#rrggbb`. */
+function hueOf(hex) {
+  const n = parseInt(hex.replace("#", ""), 16);
+  return rgbToOklch((n >> 16) & 255, (n >> 8) & 255, n & 255).h;
+}
+
+/**
+ * Whether a colour is one of Bitwarden's blues (as opposed to a neutral grey with a blue cast):
+ * a blue hue with real chroma, or a very light tint that still carries some.
+ */
+function isBrandBlue({ L, C, h }) {
+  if (h < 235 || h > 290) {
+    return false;
+  }
+  return (
+    C >= 0.07 || (L >= 0.7 && C >= 0.05) || (L >= 0.86 && C >= 0.025) || (L >= 0.95 && C >= 0.012)
+  );
+}
+
+function makeRecolor(brandHex) {
+  const brandHue = hueOf(brandHex);
+  const cache = new Map();
+
+  const rotate = (r, g, b) => {
+    const key = `${r},${g},${b}`;
+    if (!cache.has(key)) {
+      const lch = rgbToOklch(r, g, b);
+      cache.set(key, isBrandBlue(lch) ? oklchToRgb(lch.L, lch.C, brandHue) : null);
+    }
+    return cache.get(key);
+  };
+
+  const hex2 = (n) => n.toString(16).padStart(2, "0");
+
+  /** Rewrites the blues in a CSS or JS text; returns it unchanged when nothing is blue. */
+  return function recolor(text) {
+    let out = text.replace(/#([0-9a-fA-F]{6})(?![0-9a-zA-Z_-])/g, (match, hex) => {
+      const n = parseInt(hex, 16);
+      const rotated = rotate((n >> 16) & 255, (n >> 8) & 255, n & 255);
+      if (!rotated) {
+        return match;
+      }
+      const result = `#${rotated.map(hex2).join("")}`;
+      return hex === hex.toUpperCase() ? result.toUpperCase() : result;
+    });
+    out = out.replace(
+      /(rgba?\(\s*)(\d{1,3})(\s*,\s*)(\d{1,3})(\s*,\s*)(\d{1,3})/g,
+      (match, open, r, sep1, g, sep2, b) => {
+        const rotated = rotate(+r, +g, +b);
+        return rotated ? `${open}${rotated[0]}${sep1}${rotated[1]}${sep2}${rotated[2]}` : match;
+      },
+    );
+    out = out.replace(
+      /(--[\w-]+:\s*)(\d{1,3})(\s+)(\d{1,3})(\s+)(\d{1,3})(\s*[;}])/g,
+      (match, start, r, s1, g, s2, b, end) => {
+        const rotated = rotate(+r, +g, +b);
+        return rotated ? `${start}${rotated[0]}${s1}${rotated[1]}${s2}${rotated[2]}${end}` : match;
+      },
+    );
+    return out;
+  };
+}
+
+/**
+ * Webpack plugin: recolours the emitted CSS, and the JS of the in-page UI (content scripts,
+ * inline menu, notification bar), before minification.
+ */
+class SmartfillRecolorPlugin {
+  constructor({ brandColour, test }) {
+    this.recolor = makeRecolor(brandColour);
+    this.test = test;
+  }
+
+  apply(compiler) {
+    const { Compilation, sources } = compiler.webpack;
+    compiler.hooks.thisCompilation.tap("SmartfillRecolorPlugin", (compilation) => {
+      compilation.hooks.processAssets.tap(
+        { name: "SmartfillRecolorPlugin", stage: Compilation.PROCESS_ASSETS_STAGE_OPTIMIZE },
+        (assets) => {
+          for (const name of Object.keys(assets)) {
+            if (!this.test(name)) {
+              continue;
+            }
+            const source = compilation.getAsset(name).source.source().toString();
+            const recoloured = this.recolor(source);
+            if (recoloured !== source) {
+              compilation.updateAsset(name, new sources.RawSource(recoloured));
+            }
+          }
+        },
+      );
+    });
+  }
+}
+
+module.exports = { makeRecolor, rgbToOklch, isBrandBlue, SmartfillRecolorPlugin };
