diff --git a/apps/browser/webpack/smartfill-brand/index.js b/apps/browser/webpack/smartfill-brand/index.js
new file mode 100644
index 0000000..9df8fca
--- /dev/null
+++ b/apps/browser/webpack/smartfill-brand/index.js
@@ -0,0 +1,172 @@
+/**
+ * Smartfill fork (Taviri): everything the build does to brand the extension, driven by
+ * `brand.json`. `SMARTFILL_BRANDING=off` builds with upstream's name, artwork, colours and texts.
+ *
+ * - Artwork: Bitwarden's logo, app icon and shield modules are swapped for the brand's
+ *   (`src/autofill/smartfill/brand/`). Toolbar icons come from `images/` (see webpack.base.js).
+ * - Colours: Bitwarden's blues become the brand colour in the emitted CSS and in-page scripts
+ *   (`recolor.js`).
+ * - Texts: "Bitwarden" becomes the brand name in every locale and page title, except where it
+ *   names Bitwarden the company, its servers or its other products and plans, and the copyright.
+ */
+const path = require("path");
+
+const { SmartfillRecolorPlugin } = require("./recolor");
+
+const brand = require("./brand.json");
+
+const brandingEnabled = process.env.SMARTFILL_BRANDING !== "off";
+
+/** Where the brand's artwork modules live, and which Bitwarden modules they replace. */
+const BRAND_DIR = path.resolve(__dirname, "../../src/autofill/smartfill/brand");
+const ARTWORK = [
+  {
+    context: /libs[\\/]assets[\\/]src[\\/]svg[\\/]svgs$/,
+    request: "./bitwarden-logo.icon",
+    file: "brand-logo.icon.ts",
+  },
+  {
+    context: /libs[\\/]assets[\\/]src[\\/]svg[\\/]svgs$/,
+    request: "./bitwarden-icon",
+    file: "brand-icon.ts",
+  },
+  {
+    context: /libs[\\/]assets[\\/]src[\\/]svg[\\/]svgs$/,
+    request: "./shield",
+    file: "brand-shield.ts",
+  },
+  {
+    context: /src[\\/]autofill[\\/]content[\\/]components[\\/]icons$/,
+    request: "./shield",
+    file: "brand-content-shield.ts",
+  },
+];
+
+/**
+ * "Bitwarden" followed by one of these stays: it names the company (copyright), its servers, or
+ * Bitwarden's own products and paid plans, which a Taviri build still talks to.
+ */
+const KEEP_AFTER = [
+  "Inc",
+  ", Inc",
+  "Authenticator",
+  "Secrets Manager",
+  "Premium",
+  "Families",
+  "Teams",
+  "Enterprise",
+  "Business",
+  "Cloud",
+  "cloud",
+  "server",
+  "Server",
+  "Help Center",
+  "Help center",
+  "Community",
+  "Customer Support",
+  "support",
+  "Support",
+];
+
+/**
+ * Texts that point at Bitwarden itself (its website, help center, support, downloads, store
+ * page, newsletter, business offer) keep its name: the links behind them go to Bitwarden.
+ */
+const KEEP_KEYS = new Set([
+  "moreFromBitwarden",
+  "bitwardenForBusiness",
+  "bitwardenForBusinessPageDesc",
+  "helpCenter",
+  "communityForums",
+  "contactSupport",
+  "bitwardenSupport",
+  "continueToHelpCenterDesc",
+  "continueToBrowserExtensionStoreDesc",
+  "downloadBitwarden",
+  "downloadBitwardenOnAllDevices",
+  "downloadBitwardenApps",
+  "getTheMobileAppDesc",
+  "receiveMarketingEmails",
+]);
+const BRAND_WORD = new RegExp(
+  `\\bBitwarden\\b(?!\\.\\w)(?!\\s*(?:${KEEP_AFTER.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})\\b)`,
+  "g",
+);
+
+function rebrandText(text) {
+  if (typeof text !== "string" || /©|\(c\)|copyright/i.test(text)) {
+    return text;
+  }
+  return text.replace(BRAND_WORD, brand.name);
+}
+
+/** CopyWebpackPlugin transform for `_locales/<lang>/messages.json`. */
+function rebrandLocaleFile(content, absoluteFrom) {
+  if (!brandingEnabled || !absoluteFrom.endsWith("messages.json")) {
+    return content;
+  }
+  const messages = JSON.parse(content.toString());
+  for (const [key, entry] of Object.entries(messages)) {
+    if (entry && typeof entry.message === "string" && !KEEP_KEYS.has(key)) {
+      entry.message = rebrandText(entry.message);
+    }
+  }
+  return JSON.stringify(messages, null, 2);
+}
+
+/** Renames Bitwarden in the <title> of the extension's pages. */
+class SmartfillHtmlTitlePlugin {
+  constructor(HtmlWebpackPlugin) {
+    this.HtmlWebpackPlugin = HtmlWebpackPlugin;
+  }
+
+  apply(compiler) {
+    compiler.hooks.compilation.tap("SmartfillHtmlTitlePlugin", (compilation) => {
+      this.HtmlWebpackPlugin.getHooks(compilation).beforeEmit.tap(
+        "SmartfillHtmlTitlePlugin",
+        (data) => {
+          data.html = data.html.replace(/<title>([^<]*)<\/title>/g, (match, title) =>
+            match.replace(title, rebrandText(title)),
+          );
+          return data;
+        },
+      );
+    });
+  }
+}
+
+/** The plugins both builds (popup + content scripts, background) get. */
+function smartfillPlugins(webpack) {
+  if (!brandingEnabled) {
+    return [];
+  }
+  return [
+    new webpack.NormalModuleReplacementPlugin(
+      /^\.\/(bitwarden-logo\.icon|bitwarden-icon|shield)$/,
+      (resource) => {
+        const swap = ARTWORK.find(
+          (entry) =>
+            entry.request === resource.request && entry.context.test(resource.context || ""),
+        );
+        if (swap) {
+          resource.request = path.join(BRAND_DIR, swap.file);
+        }
+      },
+    ),
+    new SmartfillRecolorPlugin({
+      brandColour: brand.colour,
+      // All stylesheets and UI scripts (colours set from code: avatars, in-page UI, artwork).
+      test: (name) =>
+        /\.css$/.test(name) || (/\.js$/.test(name) && !/(^|\/)background\.js$|wasm/.test(name)),
+    }),
+  ];
+}
+
+module.exports = {
+  brand,
+  brandingEnabled,
+  rebrandText,
+  rebrandLocaleFile,
+  smartfillPlugins,
+  SmartfillHtmlTitlePlugin,
+};
