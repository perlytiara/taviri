-// Smartfill fork: this is a modified build, so it says so in its name and description, and it
-// uses its own Firefox add-on id so it can never replace the official add-on. Overrides live in
-// `manifest-smartfill-overrides.json`. Set SMARTFILL_BRANDING=off to build with upstream's names.
+// Smartfill fork: this is a modified build under its own name. The name comes from one place,
+// `smartfill-brand/brand.json`; the description says what the build is based on, and Firefox gets
+// the fork's own add-on id so it can never replace the official add-on.
+// Set SMARTFILL_BRANDING=off to build with upstream's names.
 function transformSmartfill(manifest) {
   if (process.env.SMARTFILL_BRANDING === "off") {
     return manifest;
   }
-  return applyOverrides(manifest, require("./manifest-smartfill-overrides.json"));
+  return applyOverrides(manifest, smartfillBrandOverrides(require("./smartfill-brand/brand.json")));
+}
+
+function smartfillBrandOverrides(brand) {
+  const name = String(brand.name || "").trim();
+  const basedOn = String(brand.basedOn || "Bitwarden").trim();
+  if (!name) {
+    throw new Error("smartfill-brand/brand.json needs a name");
+  }
+  return {
+    name,
+    short_name: name,
+    description: `${name} is based on ${basedOn}: an unofficial, modified build of its browser extension (GPL-3.0). Not affiliated with ${basedOn} Inc.`,
+    action: { default_title: name },
+    browser_action: { default_title: name },
+    sidebar_action: { default_title: name },
+    browser_specific_settings: { gecko: { id: brand.firefoxAddonId } },
+  };
 }
 
 function applyOverrides(target, overrides) {
@@ -111,4 +129,5 @@ function transformPrefixes(manifest, browser) {
 
 module.exports = {
   transform,
+  smartfillBrandOverrides,
 };
