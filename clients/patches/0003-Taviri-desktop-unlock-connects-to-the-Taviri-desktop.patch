index 0000000..41ae8e6
--- /dev/null
+++ b/apps/browser/src/autofill/smartfill/smartfill-native-host.ts
@@ -0,0 +1,11 @@
+/**
+ * Taviri fork — the name of the desktop app's native-messaging host the extension connects to
+ * (desktop unlock / biometrics). It comes from `nativeMessagingHost` in
+ * `webpack/smartfill-brand/brand.json`, injected at build time, so the extension only ever talks to
+ * the Taviri desktop app and never to the official Bitwarden one. Without the build setting (tests,
+ * `SMARTFILL_BRANDING=off`) it is Bitwarden's own host name.
+ */
+export const BITWARDEN_NATIVE_MESSAGING_HOST = "com.8bit.bitwarden";
+
+export const NATIVE_MESSAGING_HOST: string =
+  process.env.SMARTFILL_NATIVE_MESSAGING_HOST || BITWARDEN_NATIVE_MESSAGING_HOST;
