+// Taviri fork: the brand the app was built with (see apps/desktop/taviri/brand.js).
+//
+// webpack bakes TAVIRI_BRAND into the main, preload and renderer bundles. When it is missing
+// (unit tests, or a build with TAVIRI_BRAND=off) `taviriBrand` is null and every patched place
+// behaves exactly like upstream Bitwarden.
+
+export type TaviriBrand = {
+  /** Display name: app, dock, menus, window title. */
+  name: string;
+  /** What it is based on ("Bitwarden"). */
+  basedOn: string;
+  /** macOS bundle id. */
+  appId: string;
+  /** Folder name under ~/Library/Application Support. */
+  dataFolder: string;
+  /** URL scheme registered instead of bitwarden:// (which stays with the official app). */
+  urlScheme: string;
+  /** Native messaging host name used instead of com.8bit.bitwarden. */
+  nativeMessagingHost: string;
+  /** Chrome extension ids allowed to use the browser bridge. */
+  chromeExtensionIds: string[];
+  /** Firefox add-on ids allowed to use the browser bridge. */
+  firefoxExtensionIds: string[];
+  /** "<name> is based on Bitwarden ..." */
+  description: string;
+  /** Copyright line for the About window. */
+  copyright: string;
+};
+
+declare const TAVIRI_BRAND: TaviriBrand | undefined;
+
+export const taviriBrand: TaviriBrand | null =
+  typeof TAVIRI_BRAND !== "undefined" && TAVIRI_BRAND != null ? TAVIRI_BRAND : null;
+
+/** The bitwarden:// links the app understands, under the fork's own scheme. */
+export function toBitwardenDeepLink(url: string): string | null {
+  if (url.indexOf("bitwarden://") === 0) {
+    return url;
+  }
+  if (taviriBrand != null && url.indexOf(`${taviriBrand.urlScheme}://`) === 0) {
+    return "bitwarden://" + url.substring(taviriBrand.urlScheme.length + 3);
+  }
+  return null;
+}
