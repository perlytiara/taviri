+/* eslint-disable @typescript-eslint/no-require-imports, no-console */
+// Taviri fork: after-pack for the local unsigned build (see electron-builder.taviri.js).
+//
+// Upstream's after-pack needs Bitwarden's signing identity (it signs desktop_proxy) and copies
+// the autofill and Safari extensions, which need Bitwarden's Apple team. Here only the Electron
+// fuses are set, the same ones upstream sets on its release builds (no ELECTRON_RUN_AS_NODE,
+// no --inspect, app only from the integrity-checked app.asar, cookie encryption on).
+// taviri-desktop/build.sh signs the finished app ad hoc afterwards.
+const { addElectronFuses } = require("../scripts/after-pack");
+
+exports.default = async function run(context) {
+  console.log("## Taviri after pack: Electron fuses");
+  await addElectronFuses(context);
+};
diff --git a/apps/desktop/taviri/brand.js b/apps/desktop/taviri/brand.js
new file mode 100644
index 0000000..f19b702
--- /dev/null
+++ b/apps/desktop/taviri/brand.js
@@ -0,0 +1,168 @@
+/* eslint-disable @typescript-eslint/no-require-imports, no-console */
+// Taviri fork: the one place the desktop build learns its name and ids.
+//
+// - The display name comes from the browser extension's brand file (`nameFile` in brand.json),
+//   so a single edit renames the extension and the desktop app.
+// - The ids in brand.json (bundle id, data folder, URL scheme, browser bridge name, socket names)
+//   are what keep Taviri apart from an installed Bitwarden. They stay fixed on a rename.
+//
+// Used by webpack.base.js (main/renderer/preload bundles), taviri/electron-builder.taviri.js
+// (packaging) and taviri-desktop/build.sh (native build). Nothing here runs in the app.
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+
+const BRAND_FILE = path.join(__dirname, "brand.json");
+
+// i18n messages that name *this app* (menus, tray, settings about the app). In these, the word
+// "Bitwarden" becomes the brand name in every locale. Messages about the Bitwarden service,
+// account, company or products (Bitwarden Send, Bitwarden Authenticator, support, web app)
+// are left alone.
+const APP_NAME_MESSAGE_KEYS = [
+  "bitwarden",
+  "bitwardenBeta",
+  "aboutBitwarden",
+  "hideBitwarden",
+  "quitBitwarden",
+  "runInBackground",
+  "runInBackgroundDesc",
+  "runInBackgroundDescMac",
+  "openAtLoginDesc",
+  "closeThisBitwardenWindow",
+  "allowScreenshotsDesc",
+  "verifyNativeMessagingConnectionTitle",
+  "setYourPinCode",
+  "requireMasterPasswordOnAppRestartWarning",
+  "biometricsStatusHelptextNotEnabledLocally",
+];
+
+function expandHome(p) {
+  return p && p.startsWith("~/") ? path.join(os.homedir(), p.slice(2)) : p;
+}
+
+function readJson(file) {
+  return JSON.parse(fs.readFileSync(file, "utf8"));
+}
+
+function check(condition, message) {
+  if (!condition) {
+    throw new Error(`[taviri] ${BRAND_FILE}: ${message}`);
+  }
+}
+
+/** Loads and checks the brand. Throws with a readable message when something is off. */
+function loadBrand() {
+  const desktop = readJson(BRAND_FILE);
+  const nameFile = path.resolve(__dirname, desktop.nameFile);
+  const shared = readJson(nameFile);
+
+  const name = String(shared.name || "").trim();
+  const basedOn = String(shared.basedOn || "Bitwarden").trim();
+  check(name.length > 0 && !/[/:\\]/.test(name), `"name" in ${nameFile} is empty or has / : \\`);
+  check(/^[a-z0-9-]+(\.[a-z0-9-]+)+$/i.test(desktop.appId), `"appId" must look like a.b.c`);
+  check(desktop.appId !== "com.bitwarden.desktop", `"appId" must not be Bitwarden's`);
+  // The browser bridge name may also live in the shared file (the extension connects to it);
+  // when it does, that value wins so the two cannot drift apart.
+  const nativeMessagingHost = shared.nativeMessagingHost || desktop.nativeMessagingHost;
+  check(/^[a-z][a-z0-9+.-]*$/.test(desktop.urlScheme), `"urlScheme" must be lower case`);
+  check(desktop.urlScheme !== "bitwarden", `"urlScheme" must not be "bitwarden"`);
+  check(
+    /^[a-z0-9_]+(\.[a-z0-9_]+)*$/.test(nativeMessagingHost) &&
+      nativeMessagingHost !== "com.8bit.bitwarden",
+    `"nativeMessagingHost" must be lower case dotted and not Bitwarden's`,
+  );
+  check(
+    desktop.dataFolder && desktop.dataFolder !== "Bitwarden" && !/[/:\\]/.test(desktop.dataFolder),
+    `"dataFolder" must be a plain folder name other than "Bitwarden"`,
+  );
+  check(
+    /^\.[A-Za-z0-9._-]+\.sock$/.test(desktop.sshSocketName) &&
+      desktop.sshSocketName !== ".bitwarden-ssh-agent.sock",
+    `"sshSocketName" must be a hidden .sock file name other than Bitwarden's`,
+  );
+
+  const chromeExtensionIds = desktop.chromeExtensionIds || [];
+  chromeExtensionIds.forEach((id) =>
+    check(/^[a-p]{32}$/.test(id), `chrome extension id "${id}" is not 32 letters a-p`),
+  );
+  const firefoxExtensionIds = shared.firefoxAddonId ? [shared.firefoxAddonId] : [];
+
+  const year = new Date().getFullYear();
+  return {
+    name,
+    basedOn,
+    appId: desktop.appId,
+    // Package name inside the app bundle (lower case, no spaces).
+    packageName: name.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
+    dataFolder: desktop.dataFolder,
+    urlScheme: desktop.urlScheme,
+    nativeMessagingHost,
+    chromeExtensionIds,
+    firefoxExtensionIds,
+    sshSocketName: desktop.sshSocketName,
+    brandKit: expandHome(desktop.brandKit),
+    description:
+      `${name} is based on ${basedOn}: an unofficial, modified build of the ${basedOn} ` +
+      `desktop app (GPL-3.0). Not affiliated with Bitwarden Inc.`,
+    copyright: `Based on ${basedOn}, copyright © 2015-${year} Bitwarden Inc. GPL-3.0.`,
+    appNameMessageKeys: APP_NAME_MESSAGE_KEYS,
+    files: { brand: BRAND_FILE, name: nameFile },
+  };
+}
+
+/** The part of the brand the app itself needs at run time (baked in by webpack). */
+function runtimeBrand(brand = loadBrand()) {
+  return {
+    name: brand.name,
+    basedOn: brand.basedOn,
+    appId: brand.appId,
+    dataFolder: brand.dataFolder,
+    urlScheme: brand.urlScheme,
+    nativeMessagingHost: brand.nativeMessagingHost,
+    chromeExtensionIds: brand.chromeExtensionIds,
+    firefoxExtensionIds: brand.firefoxExtensionIds,
+    description: brand.description,
+    copyright: brand.copyright,
+  };
+}
+
+/**
+ * Renames the app in one locale's messages.json (see APP_NAME_MESSAGE_KEYS). Returns the new
+ * file content. Leaves the file untouched when it does not parse.
+ */
+function rebrandMessages(content, brand = loadBrand()) {
+  let messages;
+  try {
+    messages = JSON.parse(content.toString());
+  } catch {
+    return content;
+  }
+  for (const key of brand.appNameMessageKeys) {
+    const entry = messages[key];
+    if (entry && typeof entry.message === "string") {
+      entry.message = entry.message.replace(/Bitwarden/g, brand.name);
+    }
+  }
+  return JSON.stringify(messages, null, 2);
+}
+
+/** Whether the desktop build should be branded (always, unless TAVIRI_BRAND=off). */
+function brandEnabled() {
+  return !["off", "0", "false", "no"].includes(
+    String(process.env.TAVIRI_BRAND || "").toLowerCase(),
+  );
+}
+
+module.exports = { loadBrand, runtimeBrand, rebrandMessages, brandEnabled };
+
+if (require.main === module) {
+  // `node taviri/brand.js [key]` prints the brand (or one value) for shell scripts.
+  const brand = loadBrand();
+  const key = process.argv[2];
+  if (key) {
+    const value = brand[key];
+    process.stdout.write(Array.isArray(value) ? value.join(" ") : String(value ?? ""));
+  } else {
+    console.log(JSON.stringify(brand, null, 2));
+  }
+}
