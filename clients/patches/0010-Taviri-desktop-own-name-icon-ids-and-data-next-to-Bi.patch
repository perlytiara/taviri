diff --git a/apps/desktop/taviri/electron-builder.taviri.js b/apps/desktop/taviri/electron-builder.taviri.js
new file mode 100644
index 0000000..4e67ea8
--- /dev/null
+++ b/apps/desktop/taviri/electron-builder.taviri.js
@@ -0,0 +1,83 @@
+/* eslint-disable @typescript-eslint/no-require-imports */
+// Taviri fork: electron-builder settings for a local, unsigned macOS build.
+//
+// Starts from upstream's electron-builder.json (so upstream changes still flow in) and changes
+// only what makes the build Taviri's and buildable without Bitwarden's Apple account:
+// name, bundle id, icon, URL scheme, no app group / provisioning profile / notarization,
+// no update feed, no autofill or Safari extension, licence + notice inside the app.
+// Signing is done afterwards by taviri-desktop/build.sh (ad-hoc), not here.
+//
+//   npx electron-builder --config taviri/electron-builder.taviri.js --mac dir --arm64 -p never
+const fs = require("fs");
+const path = require("path");
+
+const { loadBrand } = require("./brand");
+
+const base = JSON.parse(
+  fs.readFileSync(path.join(__dirname, "..", "electron-builder.json"), "utf8"),
+);
+const brand = loadBrand();
+
+// NOTICE.txt (what this build is, GPL-3.0) with the brand name filled in.
+const notice = fs
+  .readFileSync(path.join(__dirname, "NOTICE.txt"), "utf8")
+  .replace(/\{\{name\}\}/g, brand.name)
+  .replace(/\{\{basedOn\}\}/g, brand.basedOn);
+fs.mkdirSync(path.join(__dirname, "generated"), { recursive: true });
+fs.writeFileSync(path.join(__dirname, "generated", "NOTICE.txt"), notice);
+
+const generatedIcon = path.join(__dirname, "generated", "icon.icns");
+if (!fs.existsSync(generatedIcon)) {
+  throw new Error("[taviri] taviri/generated/icon.icns is missing: run node taviri/make-icons.js");
+}
+
+// Info.plist keys that tie the app to Bitwarden's Apple team. Without BitwardenAppGroupIdentifier
+// the native code keeps its sockets in ~/Library/Caches/<appId>, never in Bitwarden's group
+// container.
+const { BitwardenAppGroupIdentifier, ...extendInfo } = base.mac.extendInfo;
+void BitwardenAppGroupIdentifier;
+
+const { provisioningProfile, entitlements, entitlementsInherit, ...mac } = base.mac;
+void provisioningProfile;
+void entitlements;
+void entitlementsInherit;
+
+module.exports = {
+  ...base,
+  // No `name` here (upstream sets "bitwarden"): electron-builder finds the app's production
+  // dependencies in the npm workspace by the package name "@bitwarden/desktop"; with any other
+  // name it falls back to the whole monorepo and packs ~250 MB of unused modules. The app shows
+  // productName.
+  extraMetadata: {
+    productName: brand.name,
+    description: brand.description,
+  },
+  productName: brand.name,
+  appId: brand.appId,
+  copyright: brand.copyright,
+  // No notarization (needs Bitwarden's Apple account); after-pack without signing identity.
+  afterSign: undefined,
+  afterPack: path.join(__dirname, "after-pack.taviri.js"),
+  // No update feed: Bitwarden's would offer the official build as an update.
+  publish: null,
+  generateUpdatesFilesForAllChannels: false,
+  protocols: [{ name: brand.name, schemes: [brand.urlScheme] }],
+  extraResources: [
+    ...(base.extraResources || []),
+    { from: path.join(__dirname, "..", "..", "..", "LICENSE_GPL.txt"), to: "LICENSE_GPL.txt" },
+    { from: path.join(__dirname, "generated", "NOTICE.txt"), to: "NOTICE.txt" },
+  ],
+  mac: {
+    ...mac,
+    identity: null,
+    hardenedRuntime: false,
+    icon: generatedIcon,
+    extendInfo: {
+      ...extendInfo,
+      NSHumanReadableCopyright: brand.copyright,
+    },
+    target: [{ target: "dir", arch: ["arm64"] }],
+  },
+  mas: undefined,
+  dmg: undefined,
+};
diff --git a/apps/desktop/taviri/make-icons.js b/apps/desktop/taviri/make-icons.js
new file mode 100644
index 0000000..8b0920e
--- /dev/null
+++ b/apps/desktop/taviri/make-icons.js
@@ -0,0 +1,124 @@
+#!/usr/bin/env node
+/* eslint-disable @typescript-eslint/no-require-imports, no-console */
+// Taviri fork: makes the desktop icons from the brand kit (brand.json "brandKit"), into
+// taviri/generated/ (not committed):
+//
+//   generated/icon.icns                      app icon (Finder, Dock, About window)
+//   generated/images/icon.png                512 px app icon (window icon on Linux)
+//   generated/images/icon-template(@2x).png  menu bar icon (black, macOS tints it)
+//   generated/images/icon-highlight(@2x).png menu bar icon while its menu is open
+//
+// Kit files used: icon.svg (colour app icon) and glyph.svg (one-colour keyhole). Without the
+// kit, a placeholder is drawn: the first letter of the name, white on #047B62.
+// Tools: rsvg-convert (Homebrew librsvg) to draw the SVGs, iconutil (macOS) for the .icns.
+const { execFileSync } = require("child_process");
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+
+const { loadBrand } = require("./brand");
+
+const brand = loadBrand();
+const outDir = path.join(__dirname, "generated");
+const imagesDir = path.join(outDir, "images");
+const PLACEHOLDER_COLOUR = "#047B62";
+
+function which(tool) {
+  try {
+    return execFileSync("/usr/bin/which", [tool]).toString().trim();
+  } catch {
+    return null;
+  }
+}
+
+const rsvg = which("rsvg-convert");
+if (!rsvg) {
+  throw new Error("[taviri] rsvg-convert not found (brew install librsvg)");
+}
+
+function kitFile(name) {
+  const file = brand.brandKit ? path.join(brand.brandKit, name) : null;
+  return file && fs.existsSync(file) ? fs.readFileSync(file, "utf8") : null;
+}
+
+/** Strips the XML prolog so the SVG can be nested inside another one. */
+function svgBody(svg) {
+  return svg
+    .replace(/<\?xml[^>]*\?>/, "")
+    .replace(/<!DOCTYPE[^>]*>/i, "")
+    .trim();
+}
+
+/** Adds attributes to the root <svg> element of a document. */
+function withRootAttributes(svg, attributes) {
+  return svgBody(svg).replace(/<svg\b/, `<svg ${attributes}`);
+}
+
+const letter = brand.name.charAt(0).toUpperCase();
+const kitIcon =
+  kitFile("icon.svg") ??
+  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
+  <rect width="64" height="64" rx="15" fill="${PLACEHOLDER_COLOUR}"/>
+  <text x="32" y="34" text-anchor="middle" dominant-baseline="central" fill="#fff"
+    font-family="Helvetica Neue, Arial, sans-serif" font-size="40" font-weight="700">${letter}</text>
+</svg>`;
+// The kit draws the keyhole in the middle of a 64 x 64 box (x 22-42, y 16-48); the menu bar
+// icon crops to it so it is as tall as other menu bar icons.
+const kitGlyph = kitFile("glyph.svg");
+const GLYPH_CROP = 'viewBox="15 15 34 34"';
+
+// macOS app icon grid: an 824 px tile with 100 px margins on a 1024 canvas, with a soft
+// shadow, so the Dock shows it at the same size as other apps (and macOS does not put it on
+// a grey plate).
+const appIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">
+  <defs>
+    <filter id="shadow" x="-10%" y="-10%" width="120%" height="125%">
+      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#000" flood-opacity="0.28"/>
+    </filter>
+  </defs>
+  <g filter="url(#shadow)">
+    ${withRootAttributes(kitIcon, 'x="100" y="100" width="824" height="824"')}
+  </g>
+</svg>`;
+
+function trayIconSvg(colour) {
+  if (kitGlyph) {
+    const glyph = svgBody(kitGlyph).replace(/viewBox="[^"]*"/, GLYPH_CROP);
+    return withRootAttributes(glyph, `fill="${colour}"`);
+  }
+  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
+  <text x="32" y="34" text-anchor="middle" dominant-baseline="central" fill="${colour}"
+    font-family="Helvetica Neue, Arial, sans-serif" font-size="58" font-weight="700">${letter}</text>
+</svg>`;
+}
+
+const work = fs.mkdtempSync(path.join(os.tmpdir(), "taviri-icons-"));
+function render(svg, size, outFile) {
+  const svgFile = path.join(work, `${path.basename(outFile)}.svg`);
+  fs.writeFileSync(svgFile, svg);
+  execFileSync(rsvg, ["-w", String(size), "-h", String(size), "-o", outFile, svgFile]);
+}
+
+fs.rmSync(outDir, { recursive: true, force: true });
+fs.mkdirSync(imagesDir, { recursive: true });
+
+// .icns through an .iconset folder.
+const iconset = path.join(work, "icon.iconset");
+fs.mkdirSync(iconset);
+for (const size of [16, 32, 128, 256, 512]) {
+  render(appIconSvg, size, path.join(iconset, `icon_${size}x${size}.png`));
+  render(appIconSvg, size * 2, path.join(iconset, `icon_${size}x${size}@2x.png`));
+}
+execFileSync("/usr/bin/iconutil", ["-c", "icns", iconset, "-o", path.join(outDir, "icon.icns")]);
+render(appIconSvg, 1024, path.join(outDir, "icon-1024.png"));
+
+render(appIconSvg, 512, path.join(imagesDir, "icon.png"));
+render(trayIconSvg("#000000"), 16, path.join(imagesDir, "icon-template.png"));
+render(trayIconSvg("#000000"), 32, path.join(imagesDir, "icon-template@2x.png"));
+render(trayIconSvg("#ffffff"), 16, path.join(imagesDir, "icon-highlight.png"));
+render(trayIconSvg("#ffffff"), 32, path.join(imagesDir, "icon-highlight@2x.png"));
+
+fs.rmSync(work, { recursive: true, force: true });
+console.log(
+  `[taviri] icons for "${brand.name}" from ${kitFile("icon.svg") ? brand.brandKit : "the placeholder"} -> ${outDir}`,
+);
