@@ -0,0 +1,69 @@
+/**
+ * Smartfill fork — messages between the background and the content scripts.
+ */
+import type { SmartfillResolvedStep } from "./smartfill-recipe-format";
+
+export const SmartfillCommand = Object.freeze({
+  /** background → frame: run (or resume) a recipe. */
+  run: "runSmartfillRecipe",
+  /** background → frame: is the recipe's first target here? */
+  probe: "probeSmartfillRecipe",
+  /** background → frame: stop a running recipe. */
+  cancel: "cancelSmartfillRecipe",
+  /** background → frame: show a short notice (recipe errors). */
+  notice: "showSmartfillNotice",
+  /** frame → background: a step started, acted, finished… */
+  progress: "smartfillRecipeProgress",
+} as const);
+
+export type SmartfillRunMessage = {
+  command: typeof SmartfillCommand.run;
+  runId: string;
+  steps: SmartfillResolvedStep[];
+  /** Index of the first step to run (steps before it already ran on an earlier page). */
+  startAt: number;
+  /**
+   * True when the background continues a run after a page load. A frame that is still running
+   * the run (its document did not change after all) keeps going instead of starting over.
+   */
+  resume?: boolean;
+  /** URL the background checked against the login; the frame must still be on its origin. */
+  expectedUrl: string;
+  /** Ask before filling an http page when the login holds an https address for it. */
+  confirmInsecure?: boolean;
+  showAnimations?: boolean;
+};
+
+export type SmartfillProbeMessage = {
+  command: typeof SmartfillCommand.probe;
+  selector: string;
+};
+
+export type SmartfillCancelMessage = {
+  command: typeof SmartfillCommand.cancel;
+  runId?: string;
+};
+
+export type SmartfillNoticeMessage = {
+  command: typeof SmartfillCommand.notice;
+  text: string;
+  /** When set, the notice shows only if the frame is still on this URL's origin. */
+  expectedUrl?: string;
+};
+
+/**
+ * `start`: waiting for the step's element (nothing done yet, safe to redo);
+ * `acting`: about to click / type / press (the step counts as done if the page navigates);
+ * `done` / `skipped`: the step completed; `finished` / `failed`: the run ended.
+ */
+export type SmartfillProgressPhase =
+  "start" | "acting" | "done" | "skipped" | "finished" | "failed";
+
+export type SmartfillProgressMessage = {
+  command: typeof SmartfillCommand.progress;
+  runId: string;
+  index: number;
+  phase: SmartfillProgressPhase;
+  /** Never contains a value from the vault. */
+  error?: string;
+};
