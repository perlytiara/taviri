+  /** Presses a key on the focused element, with the default action a real key would have. */
+  private pressKey(definition: { key: string; code: string; keyCode: number }): void {
+    const target = this.deepActiveElement() ?? globalThis.document.body;
+    if (!target) {
+      return;
+    }
+    const init: KeyboardEventInit = {
+      key: definition.key,
+      code: definition.code,
+      keyCode: definition.keyCode,
+      which: definition.keyCode,
+      bubbles: true,
+      cancelable: true,
+      composed: true,
+    } as KeyboardEventInit;
