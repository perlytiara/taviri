+    const type = String((target as HTMLInputElement).type ?? "").toLowerCase();
+    const isButtonLike =
+      tag === "button" ||
+      (tag === "input" && ["button", "submit", "reset", "image"].includes(type)) ||
+      target.getAttribute("role") === "button";
+
+    if (code === "Enter") {
+      if (isButtonLike || (tag === "a" && target.hasAttribute("href"))) {
+        this.dispatchClick(target);
+        return;
+      }
+      const form = (target as HTMLInputElement).form;
+      if (tag === "input" && form) {
+        const submitter = Array.from(
+          form.querySelectorAll<HTMLElement>(
+            "button:not([type]), button[type=submit], input[type=submit], input[type=image]",
+          ),
+        ).find((button) => !(button as HTMLButtonElement).disabled);
+        if (submitter) {
+          this.dispatchClick(submitter);
+        } else if (typeof form.requestSubmit === "function") {
+          form.requestSubmit();
+        } else {
+          form.submit();
+        }
+      }
+      return;
+    }
+
+    if (code === "Space") {
+      if (isButtonLike || (tag === "input" && (type === "checkbox" || type === "radio"))) {
+        this.dispatchClick(target);
+      }
+      return;
+    }
