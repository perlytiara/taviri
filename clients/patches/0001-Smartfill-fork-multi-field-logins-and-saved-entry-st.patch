+/**
+ * Smartfill fork — matching a login's extra custom fields ("Numéro allocataire", "Code
+ * confidentiel"…) to the page's form controls. Same rules as the Grok Bot connector's
+ * `__matchFields` (`docs/recipes.md`, section 1); keep both in sync.
+ *
+ * The field name is compared with each control's label, aria-labelledby text, aria-label,
+ * placeholder, name, id and title, ignoring case and accents:
+ *  - 3: the normalized texts are equal,
+ *  - 2: one contains the other (both at least 4 characters),
+ *  - 1: every word of the name appears in the label.
+ * The best-scoring control wins; if two controls tie for the best score, neither is filled
+ * (better empty than wrong). Each control takes at most one field.
+ */
+import AutofillField from "../models/autofill-field";
+
+import { SMARTFILL_LABELLEDBY_PROPERTY, smartfillNormalizeLabel } from "./smartfill-text";
+
+export { SMARTFILL_LABELLEDBY_PROPERTY } from "./smartfill-text";
+
+/** Input types a custom field is never typed into. */
+const EXCLUDED_INPUT_TYPES = new Set([
+  "hidden",
+  "submit",
+  "button",
+  "image",
+  "reset",
+  "file",
+  "password",
+]);
+
+const FILLABLE_TAGS = new Set(["input", "select", "textarea"]);
+
+/** The normalized texts a control can be recognised by. */
+export function smartfillFieldLabels(field: AutofillField): string[] {
+  return [
+    field["label-tag"],
+    field[SMARTFILL_LABELLEDBY_PROPERTY],
+    field["label-aria"],
+    field.placeholder,
+    field.htmlName,
+    field.htmlID,
+    field.title,
+  ]
+    .map(smartfillNormalizeLabel)
+    .filter(Boolean);
+}
+
+/** Scores how well one normalized label matches one normalized name (0 = no match). */
+export function smartfillLabelScore(name: string, label: string): number {
+  if (!name || !label) {
+    return 0;
+  }
+  if (label === name) {
+    return 3;
+  }
+  if (name.length >= 4 && label.length >= 4 && (label.includes(name) || name.includes(label))) {
+    return 2;
+  }
+  const labelWords = label.split(" ");
+  if (name.split(" ").every((word) => labelWords.includes(word))) {
+    return 1;
+  }
+  return 0;
+}
+
+/**
+ * Whether a collected control may take an extra field: an input (not password, hidden or a
+ * button), select or textarea that is enabled, writable and viewable (checkboxes may be styled
+ * out of view).
+ */
+export function smartfillFieldIsCandidate(field: AutofillField): boolean {
+  if (!field?.opid) {
+    return false;
+  }
+  const tag = String(field.tagName ?? "").toLowerCase();
+  if (!FILLABLE_TAGS.has(tag)) {
+    return false;
+  }
+  const type = String(field.type ?? "").toLowerCase();
+  if (tag === "input" && EXCLUDED_INPUT_TYPES.has(type)) {
+    return false;
+  }
+  if (field.disabled || field.readonly) {
+    return false;
+  }
+  return !!field.viewable || type === "checkbox";
+}
+
+export type SmartfillFieldMatch = { field: AutofillField | null; ambiguous: boolean };
+
+/**
+ * Matches each name (in order) to at most one candidate control.
+ *
+ * @param names The custom field names, in the item's order.
+ * @param candidates Controls that may take a value (see {@link smartfillFieldIsCandidate}).
+ * @param taken Opids already filled by something else.
+ */
+export function smartfillMatchFields(
+  names: string[],
+  candidates: AutofillField[],
+  taken: Iterable<string> = [],
+): SmartfillFieldMatch[] {
+  const used = new Set<string>(taken);
+  const labelCache = new Map<AutofillField, string[]>();
+  const labelsOf = (field: AutofillField) => {
+    let labels = labelCache.get(field);
+    if (!labels) {
+      labels = smartfillFieldLabels(field);
+      labelCache.set(field, labels);
+    }
+    return labels;
+  };
+
+  return names.map((rawName): SmartfillFieldMatch => {
+    const name = smartfillNormalizeLabel(rawName);
+    let best: AutofillField | null = null;
+    let bestScore = 0;
+    let tie = false;
+
+    for (const field of candidates) {
+      if (used.has(field.opid)) {
+        continue;
+      }
+      let score = 0;
+      for (const label of labelsOf(field)) {
+        score = Math.max(score, smartfillLabelScore(name, label));
+      }
+      if (score > bestScore) {
+        best = field;
+        bestScore = score;
+        tie = false;
+      } else if (score && score === bestScore) {
+        tie = true;
+      }
+    }
+
+    if (!best || tie) {
+      return { field: null, ambiguous: tie };
+    }
+    used.add(best.opid);
+    return { field: best, ambiguous: false };
+  });
+}
