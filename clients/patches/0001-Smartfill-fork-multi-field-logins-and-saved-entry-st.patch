+    for (let depth = 0; element && depth < 20; depth++) {
+      const shadowActive = (element as HTMLElement).shadowRoot?.activeElement;
+      if (shadowActive) {
+        element = shadowActive;
+        continue;
+      }
+      const tag = element.tagName.toLowerCase();
+      if (tag === "iframe" || tag === "frame") {
+        let childActive: Element | null = null;
+        try {
+          childActive = (element as HTMLIFrameElement).contentDocument?.activeElement ?? null;
+        } catch {
+          childActive = null;
+        }
+        if (childActive) {
+          element = childActive;
+          continue;
+        }
+      }
+      break;
+    }
+    return element;
+  }
+
+  private isOnOrigin(expectedUrl: string | undefined): boolean {
+    try {
+      return (
+        !!expectedUrl &&
+        globalThis.location.origin !== "null" &&
+        new URL(expectedUrl).origin === globalThis.location.origin
+      );
+    } catch {
+      return false;
+    }
+  }
+
+  /** Elements reached through same-origin child frames must still share this frame's origin. */
+  private elementIsOnRunOrigin(element: Element): boolean {
+    const view = element.ownerDocument?.defaultView as (Window & { origin?: string }) | null;
+    const origin = view?.origin ?? element.ownerDocument?.location?.origin;
+    return origin === globalThis.location.origin;
+  }
+
+  private userConfirmsInsecureFill(): boolean {
+    if (globalThis.location.protocol !== "http:") {
+      return true;
+    }
+    const warning = [
+      chrome.i18n.getMessage("insecurePageWarning"),
+      chrome.i18n.getMessage("insecurePageWarningFillPrompt", [globalThis.location.hostname]),
+    ].join("\n\n");
+    return globalThis.confirm(warning);
+  }
+
+  private readonly handlePageLeaving = () => {
+    this.navigationStarted = true;
+    void this.setFillingFlag(false);
+  };
+
+  private watchNavigation(enabled: boolean): void {
+    if (enabled) {
+      globalThis.addEventListener("beforeunload", this.handlePageLeaving);
+      globalThis.addEventListener("pagehide", this.handlePageLeaving);
+      return;
+    }
+    globalThis.removeEventListener("beforeunload", this.handlePageLeaving);
+    globalThis.removeEventListener("pagehide", this.handlePageLeaving);
+  }
+
+  /** Waits for the page to go away. Returns true if it is still here afterwards. */
+  private async navigationGracePeriodPassed(run: ActiveRun): Promise<boolean> {
+    await this.sleep(NAVIGATION_GRACE_MS, run);
+    if (run.cancelled) {
+      return false;
+    }
+    this.navigationStarted = false;
+    await this.setFillingFlag(true);
+    return true;
+  }
+
+  private async setFillingFlag(isFieldCurrentlyFilling: boolean): Promise<void> {
+    try {
+      await this.sendMessage("updateIsFieldCurrentlyFilling", { isFieldCurrentlyFilling });
+    } catch {
+      // The background may be restarting; the flag only affects the inline menu.
+    }
+  }
+
+  private report(run: ActiveRun, index: number, phase: SmartfillProgressPhase, error?: string) {
+    void this.sendMessage(SmartfillCommand.progress, {
+      runId: run.runId,
+      index,
+      phase,
+      ...(error ? { error } : {}),
+    }).catch((): void => undefined);
+  }
+
+  private sleep(milliseconds: number, run?: ActiveRun): Promise<void> {
+    const end = Date.now() + Math.max(0, milliseconds);
+    return new Promise((resolve) => {
+      const tick = () => {
+        const remaining = end - Date.now();
+        if (remaining <= 0 || run?.cancelled) {
+          resolve();
+          return;
+        }
+        setTimeout(tick, Math.min(remaining, POLL_INTERVAL_MS));
+      };
+      tick();
+    });
+  }
+
+  private describeError(error: unknown): string {
+    return error instanceof Error ? error.message : String(error);
+  }
+
+  private logWarning(text: string): void {
+    // eslint-disable-next-line no-console
+    console.warn(LOG_PREFIX, text);
+  }
+}
