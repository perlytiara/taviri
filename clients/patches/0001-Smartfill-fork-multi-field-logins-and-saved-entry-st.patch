+    }
+    try {
+      const dom = (globalThis as any).chrome?.dom;
+      if (dom?.openOrClosedShadowRoot) {
+        return dom.openOrClosedShadowRoot(element) ?? null;
+      }
+      return (element as any).openOrClosedShadowRoot ?? null;
+    } catch {
+      return null;
+    }
+  }
