+    if (code === "Tab") {
+      const doc = target.ownerDocument ?? globalThis.document;
+      const focusable = Array.from(doc.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR)).filter(
+        (element) =>
+          element.tabIndex >= 0 &&
+          !(element as HTMLButtonElement).disabled &&
+          this.isShown(element),
