+  private chooseOption(select: HTMLSelectElement, value: string): string | null {
+    const options = Array.from(select.options);
+    const option =
+      options.find((candidate) => candidate.value === value) ??
+      options.find((candidate) => smartfillFoldText(candidate.text) === smartfillFoldText(value));
+    if (!option) {
+      return "no option of the drop-down matches the value";
+    }
+    select.focus();
+    select.value = option.value;
+    select.dispatchEvent(new Event("input", { bubbles: true }));
+    select.dispatchEvent(new Event("change", { bubbles: true }));
+    return null;
+  }
