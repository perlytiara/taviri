+    const remove = () => host.remove();
+    box.addEventListener("click", remove);
+    body.append(host);
+    setTimeout(remove, NOTICE_DURATION_MS);
+  }
+
+  private async execute(run: ActiveRun, message: SmartfillRunMessage): Promise<void> {
+    const { steps } = message;
+    const startAt = Math.max(0, Math.min(Number(message.startAt) || 0, steps.length));
+    if (startAt >= steps.length) {
+      this.report(run, steps.length - 1, "finished");
+      return;
+    }
+
+    if (message.confirmInsecure && !this.userConfirmsInsecureFill()) {
+      this.report(run, startAt, "failed", "cancelled on an insecure (http) page");
+      return;
+    }
+
+    this.watchNavigation(true);
+    await this.setFillingFlag(true);
+    try {
+      let index = startAt;
+      while (index < steps.length) {
+        if (run.cancelled) {
+          return;
+        }
+
+        const step = steps[index];
+        this.report(run, index, "start");
+        let outcome: StepOutcome;
+        try {
+          outcome = await this.runStep(run, index, step);
+        } catch (error) {
+          outcome = { status: "error", error: this.describeError(error) };
+        }
+        if (run.cancelled) {
+          return;
+        }
+
+        if (outcome.status === "navigating") {
+          // The page is going away; the background resumes on the next page. If the page is
+          // still here after the grace period, the navigation did not happen: carry on here.
+          if (!(await this.navigationGracePeriodPassed(run))) {
+            return;
+          }
+          if (!outcome.acted) {
+            continue;
+          }
+          this.report(run, index, "done");
+          index++;
+          continue;
+        }
+
+        if (outcome.status === "error") {
+          this.report(run, index, "failed", outcome.error);
+          this.showNotice(`Stopped at step ${index + 1} (${step.kind}): ${outcome.error}.`);
+          return;
+        }
+
+        this.report(run, index, outcome.skipped ? "skipped" : "done");
+        index++;
+      }
+      this.report(run, steps.length - 1, "finished");
+    } finally {
+      if (this.activeRun === run) {
+        this.activeRun = null;
+        this.watchNavigation(false);
+        await this.setFillingFlag(false);
+      }
+    }
+  }
+
+  private async runStep(
+    run: ActiveRun,
+    index: number,
+    step: SmartfillResolvedStep,
+  ): Promise<StepOutcome> {
+    switch (step.kind) {
+      case "wait":
+        return this.runWaitStep(run, step);
+      case "click":
+        return this.runClickStep(run, index, step);
+      case "press":
+        return this.runPressStep(run, index, step);
+      case "fill":
+        return this.runFillStep(run, index, step);
+      case "keypad":
+        return this.runKeypadStep(run, index, step);
+      default:
+        return { status: "error", error: `unknown step "${String((step as any)?.kind)}"` };
+    }
+  }
+
+  private async runWaitStep(run: ActiveRun, step: SmartfillResolvedStep): Promise<StepOutcome> {
+    if (typeof step.pauseMs === "number") {
+      await this.sleep(step.pauseMs, run);
+      return this.navigationStarted ? { status: "navigating", acted: false } : { status: "ok" };
+    }
+
+    const found = await this.waitForElement(run, step.selector ?? "", step.timeoutMs);
+    if (found.status !== "found") {
+      return this.missingOutcome(found, step, `"${step.selector}" did not appear`);
+    }
+    return { status: "ok" };
+  }
+
+  private async runClickStep(
+    run: ActiveRun,
+    index: number,
+    step: SmartfillResolvedStep,
+  ): Promise<StepOutcome> {
+    const found = await this.waitForElement(run, step.selector ?? "", step.timeoutMs);
+    if (found.status !== "found") {
+      return this.missingOutcome(found, step, `nothing to click matches "${step.selector}"`);
+    }
+
+    this.report(run, index, "acting");
+    this.dispatchClick(found.element);
+    return this.settle(run);
+  }
+
+  private async runPressStep(
+    run: ActiveRun,
+    index: number,
+    step: SmartfillResolvedStep,
+  ): Promise<StepOutcome> {
+    const definition = KEY_DEFINITIONS[String(step.value ?? "").toLowerCase()];
+    if (!definition) {
+      return {
+        status: "error",
+        error: `unknown key "${step.value}" (use Enter, Tab, Escape or Space)`,
+      };
+    }
+
+    this.report(run, index, "acting");
+    this.pressKey(definition);
+    return this.settle(run);
+  }
+
+  private async runFillStep(
+    run: ActiveRun,
+    index: number,
+    step: SmartfillResolvedStep,
+  ): Promise<StepOutcome> {
+    const found = await this.waitForElement(run, step.selector ?? "", step.timeoutMs);
+    if (found.status !== "found") {
+      return this.missingOutcome(found, step, `no field matches "${step.selector}"`);
+    }
+    if (!this.elementIsOnRunOrigin(found.element)) {
+      return {
+        status: "error",
+        error: "the field is not on the login's site, so nothing was typed",
+      };
+    }
+
+    this.report(run, index, "acting");
+    const error = await this.typeIntoElement(found.element, step.value ?? "");
+    return error ? { status: "error", error } : { status: "ok" };
+  }
+
+  private async runKeypadStep(
+    run: ActiveRun,
+    index: number,
+    step: SmartfillResolvedStep,
+  ): Promise<StepOutcome> {
+    const selector = step.selector ?? "";
+    let acted = false;
+
+    for (const character of Array.from(step.value ?? "")) {
+      const deadline = Date.now() + step.timeoutMs;
+      let key: Element | null = null;
+      let keyCount = 0;
+
+      for (;;) {
+        if (run.cancelled) {
+          return { status: "ok" };
+        }
+        if (this.navigationStarted) {
+          return { status: "navigating", acted };
+        }
+
+        let keys: Element[];
+        try {
+          keys = this.collect(selector).filter((element) => this.isShown(element));
+        } catch {
+          return { status: "error", error: `"${selector}" is not a valid CSS selector` };
+        }
+        keyCount = keys.length;
+        key = keys.find((candidate) => this.keyShows(candidate, character)) ?? null;
+        if (key || Date.now() >= deadline) {
+          break;
+        }
+        await this.sleep(POLL_INTERVAL_MS, run);
+      }
+
+      if (!key) {
+        // Never say which character was missing: that would reveal part of the secret.
+        return {
+          status: "error",
+          error: keyCount
+            ? `the keypad "${selector}" has no key for one of the characters (keys may be images without labels)`
+            : `no keypad keys match "${selector}"`,
+        };
+      }
+      if (!this.elementIsOnRunOrigin(key)) {
+        return { status: "error", error: "the keypad is not on the login's site" };
+      }
+
+      if (!acted) {
+        this.report(run, index, "acting");
+        acted = true;
+      }
+      this.dispatchClick(key);
+      await this.sleep(step.delayMs, run);
+    }
