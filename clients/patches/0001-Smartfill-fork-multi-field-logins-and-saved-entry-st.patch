+  /**
+   * Whether a field holds the value that was typed. Fields that format what is typed (a fiscal
+   * number shown as "12 34 567 890 123", a phone number, an IBAN) count as holding it when only
+   * spacing and punctuation differ.
+   */
+  private fieldHolds(actual: string, expected: string): boolean {
+    if (actual === expected) {
+      return true;
+    }
+    const strip = (text: string) => text.replace(/[^\p{L}\p{N}]+/gu, "").toLowerCase();
+    const strippedExpected = strip(expected);
+    return strippedExpected.length > 0 && strip(actual) === strippedExpected;
+  }
