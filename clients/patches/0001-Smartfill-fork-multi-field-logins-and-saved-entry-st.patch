+    return this.navigationStarted ? { status: "navigating", acted: true } : { status: "ok" };
+  }
+
+  private missingOutcome(
+    found: { status: "missing" | "invalid" | "navigating" | "cancelled" },
+    step: SmartfillResolvedStep,
+    missingMessage: string,
+  ): StepOutcome {
+    switch (found.status) {
+      case "navigating":
+        return { status: "navigating", acted: false };
+      case "cancelled":
+        return { status: "ok" };
+      case "invalid":
+        return { status: "error", error: `"${step.selector}" is not a valid CSS selector` };
+      default:
+        return step.optional
+          ? { status: "ok", skipped: true }
+          : { status: "error", error: missingMessage };
+    }
+  }
+
+  /** Waits for the first visible element matching the selector. */
+  private async waitForElement(
+    run: ActiveRun,
+    selector: string,
+    timeoutMs: number,
+  ): Promise<
+    | { status: "found"; element: Element }
+    | { status: "missing" | "invalid" | "navigating" | "cancelled" }
+  > {
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      if (run.cancelled) {
+        return { status: "cancelled" };
+      }
+      if (this.navigationStarted) {
+        return { status: "navigating" };
+      }
+
+      let element: Element | undefined;
+      try {
+        element = this.collect(selector).find((candidate) => this.isShown(candidate));
+      } catch {
+        return { status: "invalid" };
+      }
+      if (element) {
+        return { status: "found", element };
+      }
+      if (Date.now() >= deadline) {
+        return { status: "missing" };
+      }
+      await this.sleep(POLL_INTERVAL_MS, run);
+    }
+  }
