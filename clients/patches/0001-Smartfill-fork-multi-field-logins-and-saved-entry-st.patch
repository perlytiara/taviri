@@ -0,0 +1,34 @@
+/**
+ * Smartfill fork — text helpers shared by the background and the content scripts. No imports,
+ * so content bundles stay small. Same rules as the Grok Bot connector; keep both in sync.
+ */
+
+/**
+ * Folds text for name comparisons: strips accents (NFD, combining marks U+0300–U+036F),
+ * lowercases and trims. Same as the connector's `foldText`.
+ */
+export function smartfillFoldText(value: unknown): string {
+  return String(value ?? "")
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .toLowerCase()
+    .trim();
+}
+
+/**
+ * Normalizes a label for page matching: folded text with every run of non-alphanumeric
+ * characters turned into one space. Same as the connector's `__norm`.
+ */
+export function smartfillNormalizeLabel(value: unknown): string {
+  return smartfillFoldText(value)
+    .replace(/[^a-z0-9]+/g, " ")
+    .trim();
+}
+
+/** Values that tick a checkbox (a Boolean custom field stores "true" / "false"). */
+export function smartfillIsTruthy(value: unknown): boolean {
+  return /^(true|1|yes|oui|on|y|✓)$/i.test(String(value ?? "").trim());
+}
+
+/** Page-details property that carries the text of the elements named by aria-labelledby. */
+export const SMARTFILL_LABELLEDBY_PROPERTY = "label-aria-labelledby";
