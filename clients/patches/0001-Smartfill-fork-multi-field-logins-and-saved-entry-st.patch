+/**
+ * Smartfill fork — runs a login's saved entry steps ("grokbot:recipe") inside one frame.
+ *
+ * Runs as part of the autofill content script (no Angular, direct `chrome.*` use). The background
+ * resolves the values, checks the frame against the login's saved addresses and picks the frame;
+ * this class only acts on the page. Each step reports its progress so that, when a click or key
+ * press loads a new page, the background can resume on that page (after checking it again).
+ *
+ * Same step semantics as the Grok Bot connector (`docs/recipes.md`). The one
+ * unavoidable difference: an extension can only dispatch synthetic (untrusted) mouse and keyboard
+ * events, so pages that insist on `event.isTrusted` will ignore clicks and key presses.
+ */
+import {
+  SmartfillCommand,
+  SmartfillProgressPhase,
+  SmartfillRunMessage,
+} from "./smartfill-messages";
+import type { SmartfillResolvedStep } from "./smartfill-recipe-format";
+import { smartfillFoldText, smartfillIsTruthy } from "./smartfill-text";
+
+const LOG_PREFIX = "[Bitwarden Smartfill]";
+const POLL_INTERVAL_MS = 200;
+const SETTLE_DELAY_MS = 250;
+const SETTLE_TIMEOUT_MS = 10000;
+const SETTLE_POLL_MS = 150;
+/** How long a run that saw `beforeunload` waits for the page to actually go away. */
+const NAVIGATION_GRACE_MS = 20000;
+const FILL_VERIFY_DELAY_MS = 30;
+const NOTICE_DURATION_MS = 9000;
+
+type ActiveRun = { runId: string; cancelled: boolean };
+
+type StepOutcome =
+  | { status: "ok"; skipped?: boolean }
+  | { status: "error"; error: string }
+  /** The page started to unload while the step ran. */
+  | { status: "navigating"; acted: boolean };
+
+const KEY_DEFINITIONS: Record<string, { key: string; code: string; keyCode: number }> = {
+  enter: { key: "Enter", code: "Enter", keyCode: 13 },
+  tab: { key: "Tab", code: "Tab", keyCode: 9 },
+  escape: { key: "Escape", code: "Escape", keyCode: 27 },
+  space: { key: " ", code: "Space", keyCode: 32 },
+};
+
+const FOCUSABLE_SELECTOR = [
+  "a[href]",
+  "button",
+  "input:not([type=hidden])",
+  "select",
+  "textarea",
+  "[tabindex]",
+  "[contenteditable=''], [contenteditable=true]",
+].join(", ");
+
+type ElementFiller = (element: HTMLElement, value: string, showAnimations?: boolean) => void;
+type MessageSender = (command: string, options?: Record<string, unknown>) => Promise<unknown>;
+
+export class SmartfillRecipeRunner {
+  private activeRun: ActiveRun | null = null;
+  private navigationStarted = false;
+  private showAnimations = true;
+
+  /**
+   * @param fillElement Bitwarden's own value insertion (click, focus, key and input events).
+   * @param sendMessage Sends a runtime message to the background.
+   */
+  constructor(
+    private readonly fillElement: ElementFiller,
+    private readonly sendMessage: MessageSender,
+  ) {}
+
+  /** True when a visible element matching the selector is in this frame. */
+  probe(selector: string): boolean {
+    try {
+      return this.collect(selector).some((element) => this.isShown(element));
+    } catch {
+      return false;
+    }
+  }
+
+  /** Starts (or resumes) a run. Answers at once; the steps run afterwards. */
+  start(message: SmartfillRunMessage): { accepted: boolean } {
+    if (!message?.runId || !Array.isArray(message.steps) || !this.isOnOrigin(message.expectedUrl)) {
+      return { accepted: false };
+    }
+
+    if (message.resume && this.activeRun && !this.activeRun.cancelled) {
+      // The page load the background saw was not a new document for this frame (for example the
+      // fill started while the page was still loading): keep the run going under its new id.
+      this.activeRun.runId = message.runId;
+      return { accepted: true };
+    }
+
+    if (this.activeRun) {
+      this.activeRun.cancelled = true;
+    }
+    const run: ActiveRun = { runId: message.runId, cancelled: false };
+    this.activeRun = run;
+    this.navigationStarted = false;
+    this.showAnimations = message.showAnimations ?? true;
+    void this.execute(run, message).catch((error) =>
+      this.logWarning(`the steps stopped: ${this.describeError(error)}`),
+    );
+    return { accepted: true };
+  }
+
+  /** Stops the active run (or only the given run). */
+  cancel(runId?: string): void {
+    if (this.activeRun && (!runId || this.activeRun.runId === runId)) {
+      this.activeRun.cancelled = true;
+    }
+  }
+
+  /** Shows a short notice in the corner of the page (used for recipe errors). */
+  showNotice(text: string, expectedUrl?: string): void {
+    if (expectedUrl && !this.isOnOrigin(expectedUrl)) {
+      return;
+    }
+    this.logWarning(text);
+    const body = globalThis.document?.documentElement;
+    if (!body) {
+      return;
+    }
+
+    const host = globalThis.document.createElement("bitwarden-smartfill-notice");
+    host.style.setProperty("all", "initial");
+    host.style.setProperty("position", "fixed");
+    host.style.setProperty("z-index", "2147483647");
+    host.style.setProperty("right", "16px");
+    host.style.setProperty("bottom", "16px");
+    host.style.setProperty("max-width", "min(420px, calc(100vw - 32px))");
+
+    const root = host.attachShadow({ mode: "closed" });
+    const box = globalThis.document.createElement("div");
+    box.setAttribute("role", "status");
+    const title = globalThis.document.createElement("strong");
+    title.textContent = "Bitwarden Smartfill";
+    const message = globalThis.document.createElement("div");
+    message.textContent = text;
+    box.append(title, message);
+    const style = box.style;
+    style.setProperty("font", "13px/1.4 system-ui, -apple-system, Segoe UI, sans-serif");
+    style.setProperty("color", "#1b2029");
+    style.setProperty("background", "#fff8e6");
+    style.setProperty("border", "1px solid #e0b252");
+    style.setProperty("border-left", "4px solid #c98a00");
+    style.setProperty("border-radius", "8px");
+    style.setProperty("padding", "10px 12px");
+    style.setProperty("box-shadow", "0 6px 24px rgba(0,0,0,.18)");
+    style.setProperty("cursor", "pointer");
+    style.setProperty("display", "grid");
+    style.setProperty("gap", "2px");
+    root.append(box);
