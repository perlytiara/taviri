+      const cipher = loginCipher([
+        customField("Numero allocataire", "1234567"),
+        customField("Date de naissance", "01/02/1990", FieldType.Hidden),
+        customField("Pays", "france"),
+        customField("Se souvenir de moi", "true", FieldType.Boolean),
+        customField("Identifiant client", "CL-998877"),
+        customField("Code", "should-not-fill"),
+      ]);
+
+      const script = await autofillService["generateFillScript"](details, options(cipher));
+
+      expect(filledValues(script)).toEqual({
+        num: "1234567",
+        dob: "01/02/1990",
+        pays: "france",
+        remember: "true",
+        cid: "CL-998877",
+        code: "246810",
+      });
