+import AutofillField from "../models/autofill-field";
+
+import {
+  smartfillFieldIsCandidate,
+  smartfillLabelScore,
+  smartfillMatchFields,
+} from "./smartfill-field-matching";
+
+let opid = 0;
+function pageField(props: Partial<AutofillField>): AutofillField {
+  return {
+    opid: `__${opid++}`,
+    elementNumber: opid,
+    viewable: true,
+    htmlID: null,
+    htmlName: null,
+    htmlClass: null,
+    tabindex: null,
+    title: null,
+    tagName: "input",
+    type: "text",
+    ...props,
+  } as AutofillField;
+}
+
+describe("smartfillLabelScore", () => {
+  it("scores exact, partial and all-words matches like the connector", () => {
+    expect(smartfillLabelScore("numero fiscal", "numero fiscal")).toBe(3);
+    expect(smartfillLabelScore("numero fiscal", "votre numero fiscal 13 chiffres")).toBe(2);
+    expect(smartfillLabelScore("code", "code postal")).toBe(2);
+    expect(smartfillLabelScore("pin", "code pin")).toBe(1);
+    expect(smartfillLabelScore("date naissance", "naissance date du jour")).toBe(1);
+    expect(smartfillLabelScore("numero fiscal", "mot de passe")).toBe(0);
+  });
+});
+
+describe("smartfillMatchFields", () => {
+  it("matches labels ignoring case and accents, best score first", () => {
+    const allocataire = pageField({ "label-tag": "Numéro allocataire *" });
+    const code = pageField({ "label-tag": "Code confidentiel", htmlName: "pin" });
+    const search = pageField({ placeholder: "Rechercher" });
+    const matches = smartfillMatchFields(
+      ["NUMERO ALLOCATAIRE", "code confidentiel"],
+      [search, allocataire, code],
+    );
+    expect(matches.map((m) => m.field)).toEqual([allocataire, code]);
+  });
+
+  it("uses aria-labelledby text, aria-label, placeholder, name, id and title", () => {
+    const byLabelledBy = pageField({ "label-aria-labelledby": "Identifiant client" });
+    const byName = pageField({ htmlName: "date_de_naissance" });
+    expect(smartfillMatchFields(["Identifiant client"], [byLabelledBy])[0].field).toBe(
+      byLabelledBy,
+    );
+    expect(smartfillMatchFields(["Date de naissance"], [byName])[0].field).toBe(byName);
+  });
+
+  it("prefers an exact match over a partial one", () => {
+    const partial = pageField({ "label-tag": "Numéro fiscal du conjoint" });
+    const exact = pageField({ "label-tag": "Numéro fiscal" });
+    expect(smartfillMatchFields(["Numéro fiscal"], [partial, exact])[0].field).toBe(exact);
+  });
+
+  it("leaves ties empty instead of guessing", () => {
+    const first = pageField({ "label-tag": "Code" });
+    const second = pageField({ placeholder: "code" });
+    expect(smartfillMatchFields(["Code"], [first, second])).toEqual([
+      { field: null, ambiguous: true },
+    ]);
+  });
+
+  it("gives each control to one field only and skips taken ones", () => {
+    const only = pageField({ "label-tag": "Numéro client" });
+    const taken = pageField({ "label-tag": "Numéro client" });
+    const matches = smartfillMatchFields(
+      ["Numéro client", "Numero client"],
+      [only, taken],
+      [taken.opid],
+    );
+    expect(matches[0].field).toBe(only);
+    expect(matches[1].field).toBeNull();
+  });
+});
+
+describe("smartfillFieldIsCandidate", () => {
+  it("accepts visible text inputs, selects, textareas and checkboxes", () => {
+    expect(smartfillFieldIsCandidate(pageField({}))).toBe(true);
+    expect(smartfillFieldIsCandidate(pageField({ tagName: "select", type: "select-one" }))).toBe(
+      true,
+    );
+    expect(smartfillFieldIsCandidate(pageField({ type: "checkbox", viewable: false }))).toBe(true);
+  });
+
+  it("refuses passwords, hidden, buttons, read-only, disabled and invisible fields", () => {
+    expect(smartfillFieldIsCandidate(pageField({ type: "password" }))).toBe(false);
+    expect(smartfillFieldIsCandidate(pageField({ type: "hidden" }))).toBe(false);
+    expect(smartfillFieldIsCandidate(pageField({ type: "submit" }))).toBe(false);
+    expect(smartfillFieldIsCandidate(pageField({ readonly: true }))).toBe(false);
+    expect(smartfillFieldIsCandidate(pageField({ disabled: true }))).toBe(false);
+    expect(smartfillFieldIsCandidate(pageField({ viewable: false }))).toBe(false);
+    expect(smartfillFieldIsCandidate(pageField({ tagName: "span" }))).toBe(false);
+  });
+});
