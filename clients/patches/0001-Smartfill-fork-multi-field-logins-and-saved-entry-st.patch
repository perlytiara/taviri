+++ b/apps/browser/src/autofill/smartfill/smartfill-recipe.background.ts
@@ -0,0 +1,505 @@
+/**
+ * Smartfill fork — background side of saved entry steps ("grokbot:recipe").
+ *
+ * Decides whether a fill runs a recipe, resolves the values, picks the frame, sends the steps to
+ * the content script and follows the run. When a click or key press loads a new page, the run is
+ * resumed on that page only if the page is still on the login's saved site, the account is still
+ * unlocked and the tab is still the one in front. Values never leave the extension except into
+ * the page, and nothing here logs them.
+ */
+import { firstValueFrom, map } from "rxjs";
+
+import { AccountService } from "@bitwarden/common/auth/abstractions/account.service";
+import { AuthService } from "@bitwarden/common/auth/abstractions/auth.service";
+import { AuthenticationStatus } from "@bitwarden/common/auth/enums/authentication-status";
+import { DomainSettingsService } from "@bitwarden/common/autofill/services/domain-settings.service";
+import { UriMatchStrategySetting } from "@bitwarden/common/models/domain/domain-service";
+import { LogService } from "@bitwarden/common/platform/abstractions/log.service";
+import { Utils } from "@bitwarden/common/platform/misc/utils";
+import { UserId } from "@bitwarden/common/types/guid";
+import { TotpService } from "@bitwarden/common/vault/abstractions/totp.service";
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+
+import { BrowserApi } from "../../platform/browser/browser-api";
+import { AutofillOutcome } from "../enums/autofill-outcome.enum";
+import { PageDetail } from "../services/abstractions/autofill.service";
+
+import {
+  SmartfillCommand,
+  SmartfillNoticeMessage,
+  SmartfillProbeMessage,
+  SmartfillProgressMessage,
+  SmartfillProgressPhase,
+  SmartfillRunMessage,
+} from "./smartfill-messages";
+import {
+  parseSmartfillRecipe,
+  resolveSmartfillSteps,
+  SmartfillRecipeStep,
+  SmartfillResolvedStep,
+  smartfillStepSelector,
+} from "./smartfill-recipe-format";
+
+/**
+ * Recipes click and submit. Anyone who can edit a shared (organization) login could write one, so
+ * only the user's own logins may run theirs; a shared login is filled the regular way.
+ */
+export const SMARTFILL_RUN_ORGANIZATION_RECIPES = false;
+
+/** A run (with its resumes) ends after this long. */
+export const SMARTFILL_RUN_LIFETIME_MS = 120000;
+/** At most this many page loads are followed in one run. */
+export const SMARTFILL_MAX_RESUMES = 8;
+/** A freshly loaded page gets its content script a moment after `onCompleted`. */
+const RESUME_SEND_ATTEMPTS = 20;
+const RESUME_SEND_INTERVAL_MS = 250;
+
+export type SmartfillRunRequest = {
+  tab: chrome.tabs.Tab;
+  cipher: CipherView;
+  pageDetails: PageDetail[];
+  /** Premium or an organization that uses TOTP: the same entitlement Bitwarden's TOTP fill uses. */
+  canAccessTotp: boolean;
+  defaultUriMatch: UriMatchStrategySetting;
+  /** `false` for page-load fills: a login with a recipe is then left alone. */
+  allowRecipe: boolean;
+  showAnimations: boolean;
+  /** Bitwarden's insecure-page check for a frame URL (http page, https login). */
+  requiresInsecureConfirmation: (frameUrl: string) => Promise<boolean>;
+};
+
+type SmartfillRun = {
+  runId: string;
+  tabId: number;
+  frameId: number;
+  userId: UserId;
+  cipher: CipherView;
+  steps: SmartfillRecipeStep[];
+  canAccessTotp: boolean;
+  defaultUriMatch: UriMatchStrategySetting;
+  showAnimations: boolean;
+  requiresInsecureConfirmation: (frameUrl: string) => Promise<boolean>;
+  startAt: number;
+  progress: { index: number; phase: SmartfillProgressPhase } | null;
+  resumes: number;
+  expiresAt: number;
+  expiryTimer?: ReturnType<typeof setTimeout>;
+};
+
+export class SmartfillRecipeBackground {
+  private readonly runs = new Map<number, SmartfillRun>();
+  private followingNavigation = false;
+
+  constructor(
+    private readonly logService: LogService,
+    private readonly authService: AuthService,
+    private readonly accountService: AccountService,
+    private readonly domainSettingsService: DomainSettingsService,
+    private readonly totpService: TotpService,
+  ) {}
+
+  init(): void {
+    BrowserApi.addListener(chrome.runtime.onMessage, this.handleExtensionMessage);
+    // A run holds the login it is filling: let go of it as soon as the vault locks or logs out.
+    this.authService.activeAccountStatus$.subscribe((status) => {
+      if (status !== AuthenticationStatus.Unlocked) {
+        this.endAllRuns();
+      }
+    });
+  }
+
+  /**
+   * Runs the login's recipe if it has one.
+   *
+   * @returns `undefined` when the regular fill should happen instead (no recipe, or no frame on
+   * the login's site), otherwise the outcome of starting the recipe.
+   */
+  async tryRun(request: SmartfillRunRequest): Promise<AutofillOutcome | undefined> {
+    const parsed = parseSmartfillRecipe(request.cipher);
+    if (parsed === null) {
+      return undefined;
+    }
+    if (!request.allowRecipe) {
+      // Recipes click and submit, so they only run when the user asks for a fill.
+      return AutofillOutcome.Absent;
+    }
+    if (request.tab?.id == null) {
+      return AutofillOutcome.Denied;
+    }
+
+    const candidates = await this.framesOnLoginSite(request);
+    if (!candidates.length) {
+      return undefined;
+    }
+
+    if (request.cipher.organizationId && !SMARTFILL_RUN_ORGANIZATION_RECIPES) {
+      this.showNotice(
+        request.tab,
+        candidates[0],
+        "This login is shared through an organization, so its saved entry steps were not run. It was filled the regular way.",
+      );
+      return undefined;
+    }
+
+    if ("error" in parsed) {
+      this.showNotice(
+        request.tab,
+        candidates[0],
+        `The saved entry steps ("grokbot:recipe") of this login can't be used: ${parsed.error}. Fix the field in Bitwarden.`,
+      );
+      return AutofillOutcome.Denied;
+    }
+
+    const userId = await this.activeUserId();
+    if (!userId) {
+      return AutofillOutcome.Denied;
+    }
+
+    const resolved = await resolveSmartfillSteps(
+      request.cipher,
+      parsed.steps,
+      this.totpGetter(request.cipher, request.canAccessTotp),
+    );
+    if ("error" in resolved) {
+      this.showNotice(
+        request.tab,
+        candidates[0],
+        `Step ${resolved.step} of this login's entry steps can't run: ${resolved.error}.`,
+      );
+      return AutofillOutcome.Denied;
+    }
+
+    const target = await this.chooseFrame(request.tab, candidates, parsed.steps);
+    this.endRunForTab(request.tab.id, true);
+
+    const run: SmartfillRun = {
+      runId: Utils.newGuid(),
+      tabId: request.tab.id,
+      frameId: target.frameId,
+      userId,
+      cipher: request.cipher,
+      steps: parsed.steps,
+      canAccessTotp: request.canAccessTotp,
+      defaultUriMatch: request.defaultUriMatch,
+      showAnimations: request.showAnimations,
+      requiresInsecureConfirmation: request.requiresInsecureConfirmation,
+      startAt: 0,
+      progress: null,
+      resumes: 0,
+      expiresAt: Date.now() + SMARTFILL_RUN_LIFETIME_MS,
+    };
+    run.expiryTimer = setTimeout(() => this.endRun(run), SMARTFILL_RUN_LIFETIME_MS);
+    this.runs.set(run.tabId, run);
+    this.followNavigation(true);
+
+    const accepted = await this.sendRun(run, target.details.url, resolved.steps, 0, 1);
+    if (!accepted) {
+      this.endRun(run);
+      return AutofillOutcome.Denied;
+    }
+    return AutofillOutcome.Filled;
+  }
+
+  /** Frames of the target tab whose own URL matches the login, the top frame first. */
+  private async framesOnLoginSite(request: SmartfillRunRequest): Promise<PageDetail[]> {
+    const seenFrames = new Set<number>();
+    const frames: PageDetail[] = [];
+    for (const pageDetail of request.pageDetails ?? []) {
+      const frameUrl = pageDetail?.details?.url;
+      if (
+        !frameUrl ||
+        pageDetail.tab?.id !== request.tab.id ||
+        pageDetail.tab?.url !== request.tab.url ||
+        seenFrames.has(pageDetail.frameId)
+      ) {
+        continue;
+      }
+      if (await this.urlMatchesLogin(request.cipher, frameUrl, request.defaultUriMatch)) {
+        seenFrames.add(pageDetail.frameId);
+        frames.push(pageDetail);
+      }
+    }
+    return frames.sort((a, b) => Number(b.frameId === 0) - Number(a.frameId === 0));
+  }
+
+  /** The frame holding the recipe's first target, else the first frame on the login's site. */
+  private async chooseFrame(
+    tab: chrome.tabs.Tab,
+    candidates: PageDetail[],
+    steps: SmartfillRecipeStep[],
+  ): Promise<PageDetail> {
+    const selector = steps.map((step) => smartfillStepSelector(step)).find(Boolean);
+    if (!selector || candidates.length === 1) {
+      return candidates[0];
+    }
+
+    for (const candidate of candidates) {
+      const message: SmartfillProbeMessage = { command: SmartfillCommand.probe, selector };
+      const response = await BrowserApi.tabSendMessage<SmartfillProbeMessage, { found?: boolean }>(
+        tab,
+        message,
+        { frameId: candidate.frameId },
+      ).catch((): undefined => undefined);
+      if (response?.found === true) {
+        return candidate;
+      }
+    }
+    return candidates[0];
+  }
+
+  private async sendRun(
+    run: SmartfillRun,
+    expectedUrl: string,
+    steps: SmartfillResolvedStep[],
+    startAt: number,
+    attempts: number,
+  ): Promise<boolean> {
+    const message: SmartfillRunMessage = {
+      command: SmartfillCommand.run,
+      runId: run.runId,
+      steps,
+      startAt,
+      resume: run.resumes > 0,
+      expectedUrl,
+      confirmInsecure: await run.requiresInsecureConfirmation(expectedUrl),
+      showAnimations: run.showAnimations,
+    };
+
+    for (let attempt = 0; attempt < attempts; attempt++) {
+      if (this.runs.get(run.tabId) !== run) {
+        return false;
+      }
+      const response = await BrowserApi.tabSendMessage<SmartfillRunMessage, { accepted?: boolean }>(
+        { id: run.tabId } as chrome.tabs.Tab,
+        message,
+        { frameId: run.frameId },
+      ).catch((): undefined => undefined);
+      if (response?.accepted === true) {
+        return true;
+      }
+      if (attempt + 1 < attempts) {
+        await new Promise((resolve) => setTimeout(resolve, RESUME_SEND_INTERVAL_MS));
+      }
+    }
+    return false;
+  }
+
+  private readonly handleExtensionMessage = (
+    message: SmartfillProgressMessage,
+    sender: chrome.runtime.MessageSender,
+  ): void => {
+    if (message?.command !== SmartfillCommand.progress || sender?.id !== chrome.runtime.id) {
+      return;
+    }
+    const tabId = sender.tab?.id;
+    const run = tabId == null ? undefined : this.runs.get(tabId);
+    if (!run || run.runId !== message.runId || (sender.frameId ?? 0) !== run.frameId) {
+      return;
+    }
+
+    switch (message.phase) {
+      case "start":
+      case "acting":
+      case "done":
+      case "skipped":
+        run.progress = { index: Number(message.index) || 0, phase: message.phase };
+        return;
+      case "failed":
+        // The page shows the reason; the log only says where (no vault data).
+        this.logService.warning(
+          `Smartfill: entry steps stopped at step ${(Number(message.index) || 0) + 1}.`,
+        );
+        this.endRun(run);
+        return;
+      case "finished":
+        this.endRun(run);
+        return;
+    }
+  };
+
+  private readonly handleNavigationCompleted = (
+    details: chrome.webNavigation.WebNavigationFramedCallbackDetails,
+  ): void => {
+    const run = this.runs.get(details.tabId);
+    if (!run || details.frameId !== run.frameId) {
+      return;
+    }
+    void this.resume(run, details.url).catch((error: unknown) => {
+      this.logService.error(error);
+      this.endRun(run);
+    });
+  };
+
+  private readonly handleTabRemoved = (tabId: number): void => {
+    this.endRunForTab(tabId, false);
+  };
+
+  /** Continues a run on the page a click or key press loaded. */
+  private async resume(run: SmartfillRun, url: string): Promise<void> {
+    if (Date.now() > run.expiresAt || run.resumes >= SMARTFILL_MAX_RESUMES) {
+      this.endRun(run);
+      return;
+    }
+
+    const startAt = this.resumeIndex(run);
+    if (startAt >= run.steps.length) {
+      this.endRun(run);
+      return;
+    }
+
+    const status = await firstValueFrom(this.authService.activeAccountStatus$);
+    if (status !== AuthenticationStatus.Unlocked || (await this.activeUserId()) !== run.userId) {
+      this.endRun(run);
+      return;
+    }
+
+    const tab = await this.getTab(run.tabId);
+    if (!tab?.active) {
+      this.endRun(run);
+      return;
+    }
+
+    if (!(await this.urlMatchesLogin(run.cipher, url, run.defaultUriMatch))) {
+      this.logService.info("Smartfill: the page left the login's site, entry steps stopped.");
+      this.endRun(run);
+      return;
+    }
+
+    const resolved = await resolveSmartfillSteps(
+      run.cipher,
+      run.steps,
+      this.totpGetter(run.cipher, run.canAccessTotp),
+    );
+    if ("error" in resolved) {
+      this.endRun(run);
+      return;
+    }
+
+    run.runId = Utils.newGuid();
+    run.resumes++;
+    run.startAt = startAt;
+    run.progress = null;
+    const accepted = await this.sendRun(run, url, resolved.steps, startAt, RESUME_SEND_ATTEMPTS);
+    if (!accepted) {
+      this.endRun(run);
+    }
+  }
+
+  /**
+   * Where to continue after a page load: a step that was still waiting for its element runs
+   * again; a step that already clicked, typed or pressed counts as done.
+   */
+  private resumeIndex(run: SmartfillRun): number {
+    const progress = run.progress;
+    if (!progress) {
+      return run.startAt;
+    }
+    return progress.phase === "start" ? progress.index : progress.index + 1;
+  }
+
+  private endRunForTab(tabId: number, notifyFrame: boolean): void {
+    const run = this.runs.get(tabId);
+    if (!run) {
+      return;
+    }
+    if (notifyFrame) {
+      void BrowserApi.tabSendMessage(
+        { id: tabId } as chrome.tabs.Tab,
+        { command: SmartfillCommand.cancel, runId: run.runId },
+        { frameId: run.frameId },
+      ).catch((): void => undefined);
+    }
+    this.endRun(run);
+  }
+
+  private endAllRuns(): void {
+    for (const tabId of Array.from(this.runs.keys())) {
+      this.endRunForTab(tabId, true);
+    }
+  }
+
+  private endRun(run: SmartfillRun): void {
+    if (run.expiryTimer) {
+      clearTimeout(run.expiryTimer);
+    }
+    if (this.runs.get(run.tabId) === run) {
+      this.runs.delete(run.tabId);
+    }
+    if (!this.runs.size) {
+      this.followNavigation(false);
+    }
+  }
+
+  private followNavigation(enabled: boolean): void {
+    if (enabled === this.followingNavigation) {
+      return;
+    }
+    this.followingNavigation = enabled;
+    if (enabled) {
+      BrowserApi.addListener(chrome.webNavigation.onCompleted, this.handleNavigationCompleted);
+      BrowserApi.addListener(chrome.tabs.onRemoved, this.handleTabRemoved);
+      return;
+    }
+    BrowserApi.removeListener(chrome.webNavigation.onCompleted, this.handleNavigationCompleted);
+    BrowserApi.removeListener(chrome.tabs.onRemoved, this.handleTabRemoved);
+  }
+
+  private showNotice(tab: chrome.tabs.Tab, frame: PageDetail, text: string): void {
+    const message: SmartfillNoticeMessage = {
+      command: SmartfillCommand.notice,
+      text,
+      expectedUrl: frame.details.url,
+    };
+    void BrowserApi.tabSendMessage(tab, message, { frameId: frame.frameId }).catch(
+      (): void => undefined,
+    );
+  }
+
+  private totpGetter(cipher: CipherView, canAccessTotp: boolean) {
+    return async (): Promise<{ code?: string | null; error?: string }> => {
+      if (!canAccessTotp) {
+        return {
+          error:
+            "authenticator codes need Bitwarden Premium or an organization that uses them (the same rule as the official extension)",
+        };
+      }
+      const totpKey = cipher.login?.totp;
+      if (!totpKey) {
+        return { error: "the login has no authenticator key" };
+      }
+      const response = await firstValueFrom(this.totpService.getCode$(totpKey));
+      return { code: response?.code ?? null };
+    };
+  }
+
+  private async urlMatchesLogin(
+    cipher: CipherView,
+    url: string,
+    defaultUriMatch: UriMatchStrategySetting,
+  ): Promise<boolean> {
+    if (!cipher.login || !url) {
+      return false;
+    }
+    const equivalentDomains = await firstValueFrom(
+      this.domainSettingsService.getUrlEquivalentDomains(url),
+    );
+    return cipher.login.matchesUri(url, equivalentDomains, defaultUriMatch);
+  }
+
+  private activeUserId(): Promise<UserId | undefined> {
+    return firstValueFrom(
+      this.accountService.activeAccount$.pipe(map((account) => account?.id ?? undefined)),
+    );
+  }
+
+  /** `chrome.tabs.get` as a promise (BrowserApi.getTab only answers under Manifest V3). */
+  private getTab(tabId: number): Promise<chrome.tabs.Tab | undefined> {
+    return new Promise((resolve) => {
+      try {
+        chrome.tabs.get(tabId, (tab) => resolve(chrome.runtime.lastError ? undefined : tab));
+      } catch {
+        resolve(undefined);
+      }
+    });
+  }
+}
