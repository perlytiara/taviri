+function customField(name: string, value: string, type: FieldType = FieldType.Text): FieldView {
+  const view = new FieldView();
+  view.name = name;
+  view.value = value;
+  view.type = type;
+  return view;
+}
+
+function loginCipher(fields: FieldView[]): CipherView {
+  const cipher = new CipherView();
+  cipher.id = "cipher-id";
+  cipher.type = CipherType.Login;
+  cipher.login = Object.assign(new LoginView(), { username: "", password: "246810", uris: [] });
+  cipher.fields = fields;
+  return cipher;
+}
+
+let elementNumber = 0;
+function pageField(opid: string, props: Partial<AutofillField>): AutofillField {
+  return {
+    opid,
+    elementNumber: elementNumber++,
+    viewable: true,
+    htmlID: null,
+    htmlName: null,
+    htmlClass: null,
+    tabindex: null,
+    title: null,
+    tagName: "input",
+    type: "text",
+    form: "form",
+    ...props,
+  } as AutofillField;
+}
+
+function pageDetails(fields: AutofillField[]): AutofillPageDetails {
+  return {
+    title: "Mon Compte",
+    url: PAGE_URL,
+    documentUrl: PAGE_URL,
+    forms: {
+      form: { opid: "form", htmlName: "", htmlID: "login", htmlAction: "", htmlMethod: "post" },
+    },
+    fields,
+    collectedTimestamp: 0,
+  } as unknown as AutofillPageDetails;
+}
+
+/** opid → value of every fill action in the script. */
+function filledValues(script: AutofillScript | null): Record<string, string> {
+  const values: Record<string, string> = {};
+  for (const [action, opid, value] of script?.script ?? []) {
+    if (action === "fill_by_opid") {
+      values[opid] = value as string;
+    }
+  }
+  return values;
+}
+
+describe("AutofillService with Smartfill", () => {
+  const cipherService = mock<CipherService>();
+  const eventCollectionService = mock<EventCollectionService>();
