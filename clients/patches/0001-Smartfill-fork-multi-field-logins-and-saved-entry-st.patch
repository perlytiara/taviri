@@ -0,0 +1,305 @@
+import { mock } from "jest-mock-extended";
+import { BehaviorSubject, of } from "rxjs";
+
+import { AccountService } from "@bitwarden/common/auth/abstractions/account.service";
+import { AuthService } from "@bitwarden/common/auth/abstractions/auth.service";
+import { AuthenticationStatus } from "@bitwarden/common/auth/enums/authentication-status";
+import { DomainSettingsService } from "@bitwarden/common/autofill/services/domain-settings.service";
+import { LogService } from "@bitwarden/common/platform/abstractions/log.service";
+import { TotpService } from "@bitwarden/common/vault/abstractions/totp.service";
+import { CipherType, FieldType } from "@bitwarden/common/vault/enums";
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+import { FieldView } from "@bitwarden/common/vault/models/view/field.view";
+import { LoginView } from "@bitwarden/common/vault/models/view/login.view";
+
+import { BrowserApi } from "../../platform/browser/browser-api";
+import { AutofillOutcome } from "../enums/autofill-outcome.enum";
+import AutofillPageDetails from "../models/autofill-page-details";
+import { PageDetail } from "../services/abstractions/autofill.service";
+
+import { SmartfillCommand } from "./smartfill-messages";
+import { SmartfillRecipeBackground, SmartfillRunRequest } from "./smartfill-recipe.background";
+
+const SITE = "https://bank.example";
+const TAB = { id: 7, url: `${SITE}/login`, active: true } as chrome.tabs.Tab;
+
+function recipeCipher(steps: unknown, extra: Partial<LoginView> = {}): CipherView {
+  const cipher = new CipherView();
+  cipher.id = "cipher";
+  cipher.type = CipherType.Login;
+  cipher.login = Object.assign(new LoginView(), {
+    username: "client-4242",
+    password: "73519",
+    ...extra,
+  });
+  // The login is saved for bank.example only.
+  cipher.login.matchesUri = jest.fn((url: string) => url.startsWith(SITE));
+  if (steps !== undefined) {
+    const field = new FieldView();
+    field.name = "grokbot:recipe";
+    field.type = FieldType.Hidden;
+    field.value = typeof steps === "string" ? steps : JSON.stringify({ steps });
+    cipher.fields = [field];
+  }
+  return cipher;
+}
+
+function frame(frameId: number, url: string): PageDetail {
+  return { frameId, tab: TAB, details: { url, fields: [] } as unknown as AutofillPageDetails };
+}
+
+describe("SmartfillRecipeBackground", () => {
+  const logService = mock<LogService>();
+  const authService = mock<AuthService>();
+  const accountService = mock<AccountService>();
+  const domainSettingsService = mock<DomainSettingsService>();
+  const totpService = mock<TotpService>();
+  let status$: BehaviorSubject<AuthenticationStatus>;
+  let background: SmartfillRecipeBackground;
+  let sent: { message: any; frameId?: number }[];
+  let answer: (message: any, frameId?: number) => unknown;
+  const listeners = new Map<unknown, (...args: any[]) => unknown>();
+
+  const request = (
+    cipher: CipherView,
+    extra: Partial<SmartfillRunRequest> = {},
+  ): SmartfillRunRequest => ({
+    tab: TAB,
+    cipher,
+    pageDetails: [frame(0, TAB.url as string)],
+    canAccessTotp: true,
+    defaultUriMatch: 0,
+    allowRecipe: true,
+    showAnimations: true,
+    requiresInsecureConfirmation: async () => false,
+    ...extra,
+  });
+
+  const runMessages = () => sent.filter((s) => s.message.command === SmartfillCommand.run);
+  const noticeMessages = () => sent.filter((s) => s.message.command === SmartfillCommand.notice);
+  const progress = (phase: string, index: number, runId: string, frameId = 0) =>
+    listeners.get(chrome.runtime.onMessage)?.(
+      { command: SmartfillCommand.progress, runId, index, phase },
+      { id: chrome.runtime.id, tab: TAB, frameId },
+    );
+  const navigate = async (url: string, frameId = 0) => {
+    listeners.get(chrome.webNavigation.onCompleted)?.({ tabId: TAB.id, frameId, url });
+    await new Promise((resolve) => setTimeout(resolve, 20));
+  };
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    listeners.clear();
+    sent = [];
+    answer = (message) =>
+      message.command === SmartfillCommand.run ? { accepted: true } : { found: false };
+    status$ = new BehaviorSubject<AuthenticationStatus>(AuthenticationStatus.Unlocked);
+    authService.activeAccountStatus$ = status$;
+    accountService.activeAccount$ = of({ id: "user" } as any);
+    domainSettingsService.getUrlEquivalentDomains.mockReturnValue(of(new Set<string>()));
+    totpService.getCode$.mockReturnValue(of({ code: "123456", period: 30 }));
+    (chrome as any).webNavigation = {
+      onCompleted: { addListener: jest.fn(), removeListener: jest.fn() },
+    };
+    (chrome.tabs as any).onRemoved = { addListener: jest.fn(), removeListener: jest.fn() };
+    (chrome.tabs as any).get = jest.fn((_id: number, callback: (tab: chrome.tabs.Tab) => void) =>
+      callback(TAB),
+    );
+    jest.spyOn(BrowserApi, "addListener").mockImplementation((event: any, callback: any) => {
+      listeners.set(event, callback);
+    });
+    jest.spyOn(BrowserApi, "removeListener").mockImplementation((event: any) => {
+      listeners.delete(event);
+    });
+    jest
+      .spyOn(BrowserApi, "tabSendMessage")
+      .mockImplementation(async (_tab: any, message: any, options: any) => {
+        sent.push({ message, frameId: options?.frameId });
+        return answer(message, options?.frameId) as any;
+      });
+    background = new SmartfillRecipeBackground(
+      logService,
+      authService,
+      accountService,
+      domainSettingsService,
+      totpService,
+    );
+    background.init();
+  });
+
+  it("stays out of the way for logins without a recipe", async () => {
+    await expect(background.tryRun(request(recipeCipher(undefined)))).resolves.toBeUndefined();
+    expect(sent).toEqual([]);
+  });
+
+  it("never runs on a page-load fill", async () => {
+    const cipher = recipeCipher([{ click: "#go" }]);
+    await expect(background.tryRun(request(cipher, { allowRecipe: false }))).resolves.toBe(
+      AutofillOutcome.Absent,
+    );
+    expect(sent).toEqual([]);
+  });
+
+  it("leaves pages that are not on the login's site to the regular fill", async () => {
+    const cipher = recipeCipher([{ fill: "password", into: "#pw" }]);
+    const other = { ...TAB, url: "https://evil.example/" } as chrome.tabs.Tab;
+    const outcome = await background.tryRun(
+      request(cipher, {
+        tab: other,
+        pageDetails: [{ ...frame(0, "https://evil.example/"), tab: other }],
+      }),
+    );
+    expect(outcome).toBeUndefined();
+    expect(sent).toEqual([]);
+  });
+
+  it("does not run the recipe of a shared (organization) login", async () => {
+    const cipher = recipeCipher([{ click: "#transfer" }]);
+    cipher.organizationId = "org-id";
+    await expect(background.tryRun(request(cipher))).resolves.toBeUndefined();
+    expect(runMessages()).toEqual([]);
+    expect(noticeMessages()[0].message.text).toContain("shared through an organization");
+  });
+
+  it("sends resolved steps to the top frame and reports a fill", async () => {
+    const cipher = recipeCipher(
+      [
+        { fill: "username", into: "#id" },
+        { keypad: "password", keys: ".pad button" },
+        { fill: "totp", into: "#otp" },
+      ],
+      { totp: "JBSWY3DPEHPK3PXP" },
+    );
+    await expect(background.tryRun(request(cipher))).resolves.toBe(AutofillOutcome.Filled);
+
+    const [run] = runMessages();
+    expect(run.frameId).toBe(0);
+    expect(run.message.expectedUrl).toBe(TAB.url);
+    expect(run.message.startAt).toBe(0);
+    expect(run.message.steps.map((s: any) => [s.kind, s.selector, s.value])).toEqual([
+      ["fill", "#id", "client-4242"],
+      ["keypad", ".pad button", "73519"],
+      ["fill", "#otp", "123456"],
+    ]);
+  });
+
+  it("runs in the frame that holds the first target", async () => {
+    const cipher = recipeCipher([{ fill: "username", into: "#id" }]);
+    answer = (message, frameId) =>
+      message.command === SmartfillCommand.probe ? { found: frameId === 4 } : { accepted: true };
+    await background.tryRun(
+      request(cipher, {
+        pageDetails: [
+          frame(4, `${SITE}/frame`),
+          frame(0, TAB.url as string),
+          frame(9, "https://ads.example/"),
+        ],
+      }),
+    );
+    expect(
+      sent.filter((s) => s.message.command === SmartfillCommand.probe).map((s) => s.frameId),
+    ).toEqual([0, 4]);
+    expect(runMessages()[0].frameId).toBe(4);
+  });
+
+  it("shows a notice and types nothing when the recipe is broken or a value is missing", async () => {
+    await expect(background.tryRun(request(recipeCipher('{"steps":[')))).resolves.toBe(
+      AutofillOutcome.Denied,
+    );
+    await expect(
+      background.tryRun(request(recipeCipher([{ fill: "field:Missing", into: "#a" }]))),
+    ).resolves.toBe(AutofillOutcome.Denied);
+    await expect(
+      background.tryRun(
+        request(recipeCipher([{ fill: "totp", into: "#otp" }], { totp: "JBSWY3DPEHPK3PXP" }), {
+          canAccessTotp: false,
+        }),
+      ),
+    ).resolves.toBe(AutofillOutcome.Denied);
+
+    expect(runMessages()).toEqual([]);
+    expect(noticeMessages().map((n) => n.message.text)).toEqual([
+      expect.stringContaining("not valid JSON"),
+      expect.stringContaining('no custom field "Missing"'),
+      expect.stringContaining("Premium"),
+    ]);
+  });
+
+  describe("after a page load", () => {
+    const steps = [
+      { fill: "username", into: "#id" },
+      { click: "#next" },
+      { wait: "#pw" },
+      { fill: "password", into: "#pw" },
+    ];
+
+    it("continues after the step that clicked", async () => {
+      await background.tryRun(request(recipeCipher(steps)));
+      const runId = runMessages()[0].message.runId;
+      progress("done", 0, runId);
+      progress("start", 1, runId);
+      progress("acting", 1, runId);
+
+      await navigate(`${SITE}/password`);
+
+      const resumed = runMessages()[1];
+      expect(resumed.message.startAt).toBe(2);
+      expect(resumed.message.expectedUrl).toBe(`${SITE}/password`);
+      expect(resumed.message.runId).not.toBe(runId);
+    });
+
+    it("repeats a step that was still waiting for its element", async () => {
+      await background.tryRun(request(recipeCipher(steps)));
+      const runId = runMessages()[0].message.runId;
+      progress("done", 1, runId);
+      progress("start", 2, runId);
+
+      await navigate(`${SITE}/password`);
+
+      expect(runMessages()[1].message.startAt).toBe(2);
+    });
+
+    it("stops when the page left the login's site", async () => {
+      await background.tryRun(request(recipeCipher(steps)));
+      progress("acting", 1, runMessages()[0].message.runId);
+
+      await navigate("https://evil.example/steal");
+      await navigate(`${SITE}/password`);
+
+      expect(runMessages()).toHaveLength(1);
+    });
+
+    it("stops when the vault locked, the tab is no longer in front, or another frame loaded", async () => {
+      await background.tryRun(request(recipeCipher(steps)));
+      progress("acting", 1, runMessages()[0].message.runId);
+      await navigate(`${SITE}/ad`, 3);
+      expect(runMessages()).toHaveLength(1);
+
+      (chrome.tabs as any).get = jest.fn((_id: number, callback: (tab: chrome.tabs.Tab) => void) =>
+        callback({ ...TAB, active: false }),
+      );
+      await navigate(`${SITE}/password`);
+      expect(runMessages()).toHaveLength(1);
+
+      await background.tryRun(request(recipeCipher(steps)));
+      progress("acting", 1, runMessages()[1].message.runId);
+      status$.next(AuthenticationStatus.Locked);
+      await navigate(`${SITE}/password`);
+      expect(runMessages()).toHaveLength(2);
+    });
+
+    it("ignores progress from other frames, tabs and runs, and forgets finished runs", async () => {
+      await background.tryRun(request(recipeCipher(steps)));
+      const runId = runMessages()[0].message.runId;
+      progress("acting", 1, "someone-else");
+      progress("acting", 1, runId, 5);
+      await navigate(`${SITE}/password`);
+      // Nothing was recorded, so the run starts over from its first step on the new page.
+      expect(runMessages()[1].message.startAt).toBe(0);
+
+      progress("finished", 3, runMessages()[1].message.runId);
+      await navigate(`${SITE}/again`);
+      expect(runMessages()).toHaveLength(2);
+    });
+  });
+});
diff --git a/apps/browser/src/autofill/smartfill/smartfill-recipe.background.ts b/apps/browser/src/autofill/smartfill/smartfill-recipe.background.ts
