+  /**
+   * Collects matches for a CSS selector across this document, its shadow roots and its
+   * same-origin child frames (like the connector's `__collect`). Throws on an invalid selector.
+   */
+  private collect(selector: string): Element[] {
+    const found: Element[] = [];
+    const visitedDocuments = new Set<Document>();
+
+    const walk = (root: Document | ShadowRoot) => {
+      root.querySelectorAll(selector).forEach((element) => found.push(element));
+      root.querySelectorAll("*").forEach((element) => {
+        const shadowRoot = this.getShadowRoot(element);
+        if (shadowRoot) {
+          walk(shadowRoot);
+        }
+      });
+    };
+
+    const visitDocument = (doc: Document) => {
+      if (visitedDocuments.has(doc)) {
+        return;
+      }
+      visitedDocuments.add(doc);
+      walk(doc);
+      doc.querySelectorAll("iframe, frame").forEach((frame) => {
+        let childDocument: Document | null = null;
+        try {
+          childDocument = (frame as HTMLIFrameElement).contentDocument;
+        } catch {
+          childDocument = null;
+        }
+        if (childDocument) {
+          visitDocument(childDocument);
+        }
+      });
+    };
