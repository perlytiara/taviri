+        pageField("recipe", { "label-tag": "grokbot:recipe", htmlID: "grokbot:recipe" }),
+        pageField("pw", { type: "password", htmlID: "password" }),
+      ]);
+      const cipher = loginCipher([customField("grokbot:recipe", '{"steps":[{"click":"#a"}]}')]);
+
+      const script = await autofillService["generateFillScript"](details, options(cipher));
+
+      expect(filledValues(script)).toEqual({ pw: "246810" });
+    });
+
+    it("keeps Bitwarden's rule syntax working", async () => {
+      const details = pageDetails([
+        pageField("a", { htmlID: "customer_no_1" }),
+        pageField("b", { htmlID: "customer_no_2" }),
+        pageField("pw", { type: "password" }),
+      ]);
+      const cipher = loginCipher([customField("regex=^customer_no_", "4242")]);
+
+      const script = await autofillService["generateFillScript"](details, options(cipher));
+
+      expect(filledValues(script)).toEqual({ a: "4242", b: "4242", pw: "246810" });
+    });
+
+    it("leaves a ticked checkbox and a false value alone", async () => {
+      const details = pageDetails([
+        pageField("ticked", { "label-tag": "Rester connecté", type: "checkbox", checked: true }),
+        pageField("news", { "label-tag": "Newsletter", type: "checkbox", checked: false }),
+        pageField("pw", { type: "password" }),
+      ]);
+      const cipher = loginCipher([
+        customField("Rester connecté", "true", FieldType.Boolean),
+        customField("Newsletter", "false", FieldType.Boolean),
+      ]);
+
+      const script = await autofillService["generateFillScript"](details, options(cipher));
+
+      expect(filledValues(script)).toEqual({ pw: "246810" });
