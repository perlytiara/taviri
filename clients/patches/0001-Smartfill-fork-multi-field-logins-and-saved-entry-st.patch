@@ -0,0 +1,183 @@
+import { CipherType, FieldType } from "@bitwarden/common/vault/enums";
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+import { FieldView } from "@bitwarden/common/vault/models/view/field.view";
+import { LoginView } from "@bitwarden/common/vault/models/view/login.view";
+
+import {
+  parseSmartfillRecipe,
+  resolveSmartfillSteps,
+  resolveSmartfillValue,
+  smartfillExtraFields,
+  smartfillFoldText,
+  smartfillHasRecipe,
+  smartfillNormalizeLabel,
+  smartfillStepSelector,
+  smartfillStepTimeout,
+} from "./smartfill-recipe-format";
+
+function field(name: string, value: string | null, type: FieldType = FieldType.Text): FieldView {
+  const view = new FieldView();
+  view.name = name;
+  view.value = value as string;
+  view.type = type;
+  return view;
+}
+
+function login(fields: FieldView[] = [], extra: Partial<LoginView> = {}): CipherView {
+  const cipher = new CipherView();
+  cipher.type = CipherType.Login;
+  cipher.login = Object.assign(new LoginView(), {
+    username: "jdoe",
+    password: "fake-pass-123",
+    ...extra,
+  });
+  cipher.fields = fields;
+  return cipher;
+}
+
+const noTotp = async () => ({ code: null as string | null, error: "no premium" });
+
+describe("smartfill text helpers", () => {
+  it("folds accents and case like the connector", () => {
+    expect(smartfillFoldText("  Numéro Fiscal ")).toBe("numero fiscal");
+    expect(smartfillFoldText("GROKBOT:Recipe")).toBe("grokbot:recipe");
+  });
+
+  it("normalizes labels to words", () => {
+    expect(smartfillNormalizeLabel("Numéro allocataire * :")).toBe("numero allocataire");
+    expect(smartfillNormalizeLabel("Code_confidentiel(6 chiffres)")).toBe(
+      "code confidentiel 6 chiffres",
+    );
+  });
+});
+
+describe("parseSmartfillRecipe", () => {
+  it("returns null without a recipe field or for other item types", () => {
+    expect(parseSmartfillRecipe(login([field("PIN", "1234")]))).toBeNull();
+    const card = new CipherView();
+    card.type = CipherType.Card;
+    card.fields = [field("grokbot:recipe", '{"steps":[{"click":"#a"}]}')];
+    expect(parseSmartfillRecipe(card)).toBeNull();
+    expect(smartfillHasRecipe(login([field("grokbot:recipe", "   ")]))).toBe(false);
+  });
+
+  it("reads the steps object and a bare array, whatever the field name's case", () => {
+    const steps = [{ fill: "username", into: "#id" }, { click: "button[type=submit]" }];
+    expect(
+      parseSmartfillRecipe(login([field("grokbot:recipe", JSON.stringify({ steps }))])),
+    ).toEqual({ steps });
+    expect(
+      parseSmartfillRecipe(
+        login([field("GrokBot:Recipe", JSON.stringify(steps), FieldType.Hidden)]),
+      ),
+    ).toEqual({ steps });
+  });
+
+  it("explains what is wrong", () => {
+    const parse = (value: string) =>
+      parseSmartfillRecipe(login([field("grokbot:recipe", value)])) as { error: string };
+    expect(parse("{steps:").error).toMatch(/^it is not valid JSON/);
+    expect(parse('{"steps":[]}').error).toBe('it has no "steps" list');
+    expect(parse('{"steps":[{"type":"x"}]}').error).toBe(
+      "step 1 is not one of fill, click, wait, keypad, press",
+    );
+    expect(parse('[{"click":"#a"},{"fill":"password"}]').error).toBe(
+      'step 2 needs an "into" selector',
+    );
+    expect(parse('[{"press":"F5"}]').error).toMatch(/unknown key "F5"/);
+    expect(parse(JSON.stringify(Array.from({ length: 41 }, () => ({ wait: 1 })))).error).toBe(
+      "it has more than 40 steps",
+    );
+  });
+});
+
+describe("step helpers", () => {
+  it("uses the connector's timeouts", () => {
+    expect(smartfillStepTimeout({ fill: "username", into: "#a" })).toBe(5000);
+    expect(smartfillStepTimeout({ wait: "#a" })).toBe(10000);
+    expect(smartfillStepTimeout({ click: "#a", timeout: 8000 })).toBe(8000);
+    expect(smartfillStepTimeout({ click: "#a", timeout: 99999 })).toBe(30000);
+  });
+
+  it("finds each step's selector", () => {
+    expect(smartfillStepSelector({ fill: "password", into: " #pw " })).toBe("#pw");
+    expect(smartfillStepSelector({ keypad: "password", keys: ".pad button" })).toBe(".pad button");
+    expect(smartfillStepSelector({ wait: 500 })).toBeNull();
+    expect(smartfillStepSelector({ press: "Enter" })).toBeNull();
+  });
+});
+
+describe("values", () => {
+  const cipher = login([
+    field("Numéro fiscal", "1234567890123"),
+    field("Code confidentiel", "246810", FieldType.Hidden),
+    field("grokbot:recipe", '[{"click":"#a"}]'),
+    field("Linked", "x", FieldType.Linked),
+  ]);
+
+  it("resolves username, password, fields (ignoring accents), text and totp", async () => {
+    await expect(resolveSmartfillValue(cipher, "username", noTotp)).resolves.toEqual({
+      value: "jdoe",
+      kind: "username",
+    });
+    await expect(resolveSmartfillValue(cipher, "field:numero FISCAL", noTotp)).resolves.toEqual({
+      value: "1234567890123",
+      kind: "field",
+    });
+    await expect(resolveSmartfillValue(cipher, "text:France", noTotp)).resolves.toEqual({
+      value: "France",
+      kind: "text",
+    });
+    await expect(resolveSmartfillValue(cipher, "totp", noTotp)).resolves.toEqual({
+      error: "the login has no authenticator key",
+    });
+    const withTotp = login([], { totp: "JBSWY3DPEHPK3PXP" });
+    await expect(resolveSmartfillValue(withTotp, "totp", noTotp)).resolves.toEqual({
+      error: "no premium",
+    });
+    await expect(
+      resolveSmartfillValue(withTotp, "totp", async () => ({ code: "123456" })),
+    ).resolves.toEqual({ value: "123456", kind: "totp" });
+  });
+
+  it("never offers the recipe or linked fields as extra fields", async () => {
+    expect(smartfillExtraFields(cipher).map((f) => f.name)).toEqual([
+      "Numéro fiscal",
+      "Code confidentiel",
+    ]);
+    await expect(resolveSmartfillValue(cipher, "field:grokbot:recipe", noTotp)).resolves.toEqual({
+      error: 'the login has no custom field "grokbot:recipe"',
+    });
+    await expect(resolveSmartfillValue(cipher, "secret", noTotp)).resolves.toHaveProperty("error");
+  });
+
+  it("resolves a whole recipe up front and stops at the first missing value", async () => {
+    const steps = [
+      { fill: "field:Numéro fiscal", into: "input[name=spi]" },
+      { keypad: "password", keys: ".pad button", delay: 5000 },
+      { wait: 99999 },
+      { press: "Enter", optional: true },
+    ];
+    const resolved = await resolveSmartfillSteps(cipher, steps, noTotp);
+    expect(resolved).toEqual({
+      steps: [
+        expect.objectContaining({
+          kind: "fill",
+          selector: "input[name=spi]",
+          value: "1234567890123",
+        }),
+        expect.objectContaining({ kind: "keypad", value: "fake-pass-123", delayMs: 2000 }),
+        expect.objectContaining({ kind: "wait", pauseMs: 30000 }),
+        expect.objectContaining({ kind: "press", value: "enter", optional: true }),
+      ],
+    });
+
+    await expect(
+      resolveSmartfillSteps(
+        cipher,
+        [{ click: "#a" }, { fill: "field:Missing", into: "#b" }],
+        noTotp,
+      ),
+    ).resolves.toEqual({ error: 'the login has no custom field "Missing"', step: 2 });
+  });
+});
diff --git a/apps/browser/src/autofill/smartfill/smartfill-recipe-format.ts b/apps/browser/src/autofill/smartfill/smartfill-recipe-format.ts
new file mode 100644
index 0000000..aee4151
--- /dev/null
+++ b/apps/browser/src/autofill/smartfill/smartfill-recipe-format.ts
@@ -0,0 +1,320 @@
+/**
+ * Smartfill fork (unofficial, personal build) — saved entry steps ("recipes") and extra login
+ * fields. The format is shared with the Grok Bot Bitwarden connector
+ * (`docs/recipes.md`); keep both implementations in sync.
+ *
+ * A login opts in with a custom field named `grokbot:recipe` whose value is JSON:
+ * `{"steps": [{"fill": "username", "into": "#id"}, {"click": "#next"}, ...]}` (a bare array of
+ * steps is accepted too).
+ */
+import { FieldType, CipherType } from "@bitwarden/common/vault/enums";
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+
+import { smartfillFoldText } from "./smartfill-text";
+
+export { smartfillFoldText, smartfillNormalizeLabel } from "./smartfill-text";
+
+export const SMARTFILL_RECIPE_FIELD_NAME = "grokbot:recipe";
+export const SMARTFILL_MAX_RECIPE_STEPS = 40;
+export const SMARTFILL_MAX_TIMEOUT_MS = 30000;
+export const SMARTFILL_DEFAULT_TIMEOUT_MS = 5000;
+export const SMARTFILL_DEFAULT_WAIT_TIMEOUT_MS = 10000;
+export const SMARTFILL_DEFAULT_KEYPAD_DELAY_MS = 150;
+export const SMARTFILL_MAX_KEYPAD_DELAY_MS = 2000;
+
+/** Step kinds, in the order the connector checks them. */
+export const SMARTFILL_STEP_KINDS = ["fill", "keypad", "click", "wait", "press"] as const;
+export type SmartfillStepKind = (typeof SMARTFILL_STEP_KINDS)[number];
+
+/** Keys a `press` step may press. */
+export const SMARTFILL_PRESS_KEYS = ["enter", "tab", "escape", "space"] as const;
+export type SmartfillPressKey = (typeof SMARTFILL_PRESS_KEYS)[number];
+
+/** One step as written by the user (JSON). */
+export type SmartfillRecipeStep = {
+  fill?: unknown;
+  into?: unknown;
+  keypad?: unknown;
+  keys?: unknown;
+  click?: unknown;
+  wait?: unknown;
+  press?: unknown;
+  optional?: unknown;
+  timeout?: unknown;
+  delay?: unknown;
+};
+
+/**
+ * A step reduced to what the page needs. `value` holds the secret for `fill` and `keypad`
+ * steps and the key name for `press` steps; it never leaves the extension except into the page.
+ */
+export type SmartfillResolvedStep = {
+  kind: SmartfillStepKind;
+  /** CSS selector for fill (`into`), keypad (`keys`), click and wait (selector form). */
+  selector?: string;
+  value?: string;
+  /** What the step types, for messages: `username`, `password`, `totp`, `field`, `text`. */
+  valueKind?: string;
+  /** `wait` with a number: how long to pause. */
+  pauseMs?: number;
+  optional: boolean;
+  timeoutMs: number;
+  /** keypad only: pause between key presses. */
+  delayMs: number;
+};
+
+export type SmartfillRecipe = { steps: SmartfillRecipeStep[] };
+export type SmartfillRecipeParseResult = SmartfillRecipe | { error: string } | null;
+
+/** True for the custom field that holds the recipe (case- and accent-insensitive). */
+export function isSmartfillRecipeFieldName(name: unknown): boolean {
+  return smartfillFoldText(name) === SMARTFILL_RECIPE_FIELD_NAME;
+}
+
+/** Returns the step's kind, or "" when the step is not one of the five kinds. */
+export function smartfillStepKind(step: unknown): SmartfillStepKind | "" {
+  if (!step || typeof step !== "object" || Array.isArray(step)) {
+    return "";
+  }
+  const record = step as Record<string, unknown>;
+  return SMARTFILL_STEP_KINDS.find((kind) => record[kind] !== undefined) ?? "";
+}
+
+/**
+ * Finds and parses the cipher's recipe field.
+ *
+ * @returns `null` when the login has no (non-empty) recipe field, `{ error }` when the field is
+ * there but cannot be used, else the steps.
+ */
+export function parseSmartfillRecipe(
+  cipher: CipherView | null | undefined,
+): SmartfillRecipeParseResult {
+  if (!cipher || cipher.type !== CipherType.Login) {
+    return null;
+  }
+  const field = (cipher.fields ?? []).find((f) => isSmartfillRecipeFieldName(f?.name));
+  const raw = field?.value;
+  if (!field || raw == null || !String(raw).trim()) {
+    return null;
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(String(raw));
+  } catch (error) {
+    return { error: `it is not valid JSON (${(error as Error)?.message ?? "parse error"})` };
+  }
+
+  const steps = Array.isArray(parsed) ? parsed : (parsed as { steps?: unknown } | null)?.steps;
+  if (!Array.isArray(steps) || !steps.length) {
+    return { error: 'it has no "steps" list' };
+  }
+  if (steps.length > SMARTFILL_MAX_RECIPE_STEPS) {
+    return { error: `it has more than ${SMARTFILL_MAX_RECIPE_STEPS} steps` };
+  }
+  const bad = steps.findIndex((step) => !smartfillStepKind(step));
+  if (bad >= 0) {
+    return { error: `step ${bad + 1} is not one of fill, click, wait, keypad, press` };
+  }
+
+  for (let index = 0; index < steps.length; index++) {
+    const problem = describeStepProblem(steps[index] as SmartfillRecipeStep);
+    if (problem) {
+      return { error: `step ${index + 1} ${problem}` };
+    }
+  }
+
+  return { steps: steps as SmartfillRecipeStep[] };
+}
+
+/** True when the login carries a recipe field, valid or not. */
+export function smartfillHasRecipe(cipher: CipherView | null | undefined): boolean {
+  return parseSmartfillRecipe(cipher) !== null;
+}
+
+/**
+ * Shape checks the connector only discovers while running a step. Checking them up front means
+ * a broken recipe never runs halfway.
+ */
+function describeStepProblem(step: SmartfillRecipeStep): string | null {
+  const kind = smartfillStepKind(step);
+  const isText = (value: unknown) => typeof value === "string" && value.trim().length > 0;
+  switch (kind) {
+    case "fill":
+      return isText(step.into) ? null : 'needs an "into" selector';
+    case "keypad":
+      return isText(step.keys) ? null : 'needs a "keys" selector';
+    case "click":
+      return isText(step.click) ? null : "needs a selector to click";
+    case "wait":
+      return isText(step.wait) || typeof step.wait === "number"
+        ? null
+        : "needs a selector or a number of milliseconds";
+    case "press":
+      return SMARTFILL_PRESS_KEYS.includes(
+        String(step.press ?? "").toLowerCase() as SmartfillPressKey,
+      )
+        ? null
+        : `presses an unknown key "${String(step.press)}" (use Enter, Tab, Escape or Space)`;
+    default:
+      return "is not one of fill, click, wait, keypad, press";
+  }
+}
+
+/** The step's own timeout: `timeout` ms if given, else 10 s for `wait` and 5 s otherwise, at most 30 s. */
+export function smartfillStepTimeout(step: SmartfillRecipeStep): number {
+  const kind = smartfillStepKind(step);
+  const requested = Number(step.timeout);
+  const base =
+    requested && Number.isFinite(requested)
+      ? requested
+      : kind === "wait"
+        ? SMARTFILL_DEFAULT_WAIT_TIMEOUT_MS
+        : SMARTFILL_DEFAULT_TIMEOUT_MS;
+  return Math.min(Math.max(base, 0), SMARTFILL_MAX_TIMEOUT_MS);
+}
+
+/**
+ * The custom fields that act as extra login fields: named, not the recipe, not linked, with a
+ * value. Same filter as the connector's `customFields`.
+ */
+export function smartfillExtraFields(
+  cipher: CipherView,
+): { name: string; value: string; type: FieldType }[] {
+  return (cipher.fields ?? [])
+    .filter(
+      (f) =>
+        f &&
+        f.name &&
+        !isSmartfillRecipeFieldName(f.name) &&
+        f.type !== FieldType.Linked &&
+        f.value != null &&
+        f.value !== "",
+    )
+    .map((f) => ({ name: String(f.name), value: String(f.value), type: f.type }));
+}
+
+/**
+ * What a `fill` or `keypad` step types: `username`, `password`, `totp`, `field:<custom field name>`
+ * or `text:<literal>`.
+ *
+ * @param getTotpCode Returns the current code, or `null` when it may not be computed (for example,
+ * no Premium). Only called for `totp`.
+ */
+export async function resolveSmartfillValue(
+  cipher: CipherView,
+  ref: unknown,
+  getTotpCode: () => Promise<{ code?: string | null; error?: string }>,
+): Promise<{ value: string; kind: string } | { error: string }> {
+  const r = String(ref ?? "");
+  if (r === "username") {
+    return cipher.login?.username
+      ? { value: cipher.login.username, kind: "username" }
+      : { error: "the login has no username" };
+  }
+  if (r === "password") {
+    return cipher.login?.password
+      ? { value: cipher.login.password, kind: "password" }
+      : { error: "the login has no password" };
+  }
+  if (r === "totp") {
+    if (!cipher.login?.totp) {
+      return { error: "the login has no authenticator key" };
+    }
+    const totp = await getTotpCode();
+    if (totp.error || !totp.code) {
+      return { error: totp.error ?? "the authenticator code could not be computed" };
+    }
+    return { value: totp.code, kind: "totp" };
+  }
+  if (r.startsWith("field:")) {
+    const wanted = smartfillFoldText(r.slice(6));
+    const field = smartfillExtraFields(cipher).find((f) => smartfillFoldText(f.name) === wanted);
+    return field
+      ? { value: field.value, kind: "field" }
+      : { error: `the login has no custom field "${r.slice(6)}"` };
+  }
+  if (r.startsWith("text:")) {
+    return { value: r.slice(5), kind: "text" };
+  }
+  return {
+    error: `"${r}" is not a value (use username, password, totp, field:<name> or text:<words>)`,
+  };
+}
+
+/** The selector a step acts on, if any (used to pick the frame that runs the recipe). */
+export function smartfillStepSelector(step: SmartfillRecipeStep): string | null {
+  const kind = smartfillStepKind(step);
+  const selector =
+    kind === "fill"
+      ? step.into
+      : kind === "keypad"
+        ? step.keys
+        : kind === "click"
+          ? step.click
+          : kind === "wait" && typeof step.wait === "string"
+            ? step.wait
+            : null;
+  return typeof selector === "string" && selector.trim() ? selector.trim() : null;
+}
+
+/**
+ * Resolves every step's value before anything runs, so a recipe that references a missing field
+ * never runs halfway.
+ */
+export async function resolveSmartfillSteps(
+  cipher: CipherView,
+  steps: SmartfillRecipeStep[],
+  getTotpCode: () => Promise<{ code?: string | null; error?: string }>,
+): Promise<{ steps: SmartfillResolvedStep[] } | { error: string; step: number }> {
+  const resolved: SmartfillResolvedStep[] = [];
+  let totpCache: Promise<{ code?: string | null; error?: string }> | null = null;
+  const totpOnce = () => (totpCache ??= getTotpCode());
+
+  for (let index = 0; index < steps.length; index++) {
+    const step = steps[index];
+    const kind = smartfillStepKind(step) as SmartfillStepKind;
+    const base: SmartfillResolvedStep = {
+      kind,
+      optional: step.optional === true,
+      timeoutMs: smartfillStepTimeout(step),
+      delayMs: SMARTFILL_DEFAULT_KEYPAD_DELAY_MS,
+    };
+
+    if (kind === "fill" || kind === "keypad") {
+      const value = await resolveSmartfillValue(cipher, step[kind], totpOnce);
+      if ("error" in value) {
+        return { error: value.error, step: index + 1 };
+      }
+      const requestedDelay = Number(step.delay);
+      resolved.push({
+        ...base,
+        selector: smartfillStepSelector(step) ?? undefined,
+        value: value.value,
+        valueKind: value.kind,
+        delayMs:
+          kind === "keypad" && Number.isFinite(requestedDelay) && step.delay !== undefined
+            ? Math.min(Math.max(requestedDelay, 0), SMARTFILL_MAX_KEYPAD_DELAY_MS)
+            : SMARTFILL_DEFAULT_KEYPAD_DELAY_MS,
+      });
+      continue;
+    }
+
+    if (kind === "wait" && typeof step.wait === "number") {
+      resolved.push({
+        ...base,
+        pauseMs: Math.min(Math.max(step.wait, 0), SMARTFILL_MAX_TIMEOUT_MS),
+      });
+      continue;
+    }
+
+    if (kind === "press") {
+      resolved.push({ ...base, value: String(step.press).toLowerCase() });
+      continue;
+    }
+
+    resolved.push({ ...base, selector: smartfillStepSelector(step) ?? undefined });
+  }
+
+  return { steps: resolved };
+}
