+  /**
+   * After a click or key press the page may navigate: wait a moment, then until the document has
+   * finished loading. Same as the connector's `settle`.
+   */
+  private async settle(run: ActiveRun): Promise<StepOutcome> {
+    await this.sleep(SETTLE_DELAY_MS, run);
+    const deadline = Date.now() + SETTLE_TIMEOUT_MS;
+    while (Date.now() < deadline) {
+      if (this.navigationStarted) {
+        return { status: "navigating", acted: true };
+      }
+      if (run.cancelled || globalThis.document.readyState === "complete") {
+        break;
+      }
+      await this.sleep(SETTLE_POLL_MS, run);
+    }
+    return this.navigationStarted ? { status: "navigating", acted: true } : { status: "ok" };
+  }
