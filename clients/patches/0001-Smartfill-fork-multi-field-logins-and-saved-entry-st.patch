+    if (tag === "input" || tag === "textarea") {
+      if (input.disabled || input.readOnly) {
+        return "the field is read-only or disabled (an on-screen keypad may need a keypad step)";
+      }
+      if (input.value) {
+        input.value = "";
+        input.dispatchEvent(new Event("input", { bubbles: true }));
+      }
+      this.fillElement(input, value, this.showAnimations);
+      await this.sleep(FILL_VERIFY_DELAY_MS);
+      if (!this.fieldHolds(input.value, value)) {
+        this.typeCharacters(input, value);
+        await this.sleep(FILL_VERIFY_DELAY_MS);
