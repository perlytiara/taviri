diff --git a/vault/tools/preview.py b/vault/tools/preview.py
index 524e23387..ad74ab609 100644
--- a/vault/tools/preview.py
+++ b/vault/tools/preview.py
@@ -6,27 +6,43 @@ without building the app.
 """
 import re
 import subprocess
+import xml.etree.ElementTree as ElementTree
 from pathlib import Path
 
 REPO = Path(__file__).resolve().parents[2]
 OUT = REPO / "vault/preview"
 
 
+ANDROID = "{http://schemas.android.com/apk/res/android}"
+
+
 def paths(relative):
-    text = (REPO / relative).read_text(encoding="utf-8")
+    """The paths of a vector drawable: [(data, even_odd, (shift_x, shift_y, scale))]."""
     found = []
-    for match in re.finditer(r"<path(.*?)/>", text, re.S):
-        attributes = match.group(1)
-        data = re.search(r'pathData="([^"]*)"', attributes).group(1)
-        found.append((data, "evenOdd" in attributes))
+
+    def walk(element, transform):
+        if element.tag == "group":
+            scale = float(element.get(ANDROID + "scaleX", "1"))
+            shift_x = float(element.get(ANDROID + "translateX", "0"))
+            shift_y = float(element.get(ANDROID + "translateY", "0"))
+            transform = (transform[0] + transform[2] * shift_x,
+                         transform[1] + transform[2] * shift_y, transform[2] * scale)
+        if element.tag == "path":
+            found.append((element.get(ANDROID + "pathData"),
+                          element.get(ANDROID + "fillType") == "evenOdd", transform))
+        for child in element:
+            walk(child, transform)
+
+    walk(ElementTree.parse(REPO / relative).getroot(), (0.0, 0.0, 1.0))
     return found
 
 
 def draw(shapes, fill, x=0, y=0, scale=1):
     return "".join(
-        f'<path transform="translate({x},{y}) scale({scale})" d="{data}" fill="{fill}" '
+        f'<path transform="translate({x + scale * shift_x},{y + scale * shift_y}) '
+        f'scale({scale * inner})" d="{data}" fill="{fill}" '
         f'fill-rule="{"evenodd" if even_odd else "nonzero"}"/>'
-        for data, even_odd in shapes
+        for data, even_odd, (shift_x, shift_y, inner) in shapes
     )
 
 
