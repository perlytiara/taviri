diff --git a/vault/tools/preview.py b/vault/tools/preview.py
new file mode 100644
index 000000000..524e23387
--- /dev/null
+++ b/vault/tools/preview.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Draws vault/preview/brand.png: launcher icon, themed icon, wordmark and palette as built now.
+
+Needs `rsvg-convert` (Homebrew librsvg). Run after vault/apply_brand.py to look at a new brand
+without building the app.
+"""
+import re
+import subprocess
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+OUT = REPO / "vault/preview"
+
+
+def paths(relative):
+    text = (REPO / relative).read_text(encoding="utf-8")
+    found = []
+    for match in re.finditer(r"<path(.*?)/>", text, re.S):
+        attributes = match.group(1)
+        data = re.search(r'pathData="([^"]*)"', attributes).group(1)
+        found.append((data, "evenOdd" in attributes))
+    return found
+
+
+def draw(shapes, fill, x=0, y=0, scale=1):
+    return "".join(
+        f'<path transform="translate({x},{y}) scale({scale})" d="{data}" fill="{fill}" '
+        f'fill-rule="{"evenodd" if even_odd else "nonzero"}"/>'
+        for data, even_odd in shapes
+    )
+
+
+def main():
+    kotlin = (REPO / "ui/src/main/kotlin/com/bitwarden/ui/platform/theme/color/ColorScheme.kt")
+    palette = dict(re.findall(r"val (\w+): Color = Color\(color = 0xFF([0-9A-F]{6})\)",
+                              kotlin.read_text(encoding="utf-8")))
+    background = re.search(
+        r'ic_launcher_background">#FF([0-9A-Fa-f]{6})',
+        (REPO / "app/src/main/res/values/ic_launcher_background.xml").read_text(),
+    ).group(1)
+    foreground = paths("app/src/release/res/drawable/ic_launcher_foreground.xml")
+    monochrome = paths("app/src/release/res/drawable/ic_launcher_monochrome.xml")
+    wordmark = paths("app/src/vault/res/drawable/logo_bitwarden.xml")
+    notification = paths("app/src/vault/res/drawable/ic_notification.xml")
+    svg = ['<svg xmlns="http://www.w3.org/2000/svg" width="1100" height="560">',
+           '<rect width="1100" height="560" fill="#e9ecec"/>']
+    icons = ((f"#{background}", "#fff", foreground),
+             ("#dfe7e4", f"#{palette['blue700']}", monochrome))
+    for index, (back, front, shapes) in enumerate(icons):
+        x = 30 + index * 250
+        svg.append(f'<clipPath id="c{index}"><rect x="{x}" y="30" width="216" height="216" '
+                   f'rx="62"/></clipPath><g clip-path="url(#c{index})">'
+                   f'<rect x="{x}" y="30" width="216" height="216" fill="{back}"/>'
+                   + draw(shapes, front, x - 54, 30 - 54, 3) + "</g>")
+    svg.append('<clipPath id="s"><rect x="540" y="40" width="48" height="48" rx="14"/></clipPath>'
+               f'<g clip-path="url(#s)"><rect x="540" y="40" width="48" height="48" '
+               f'fill="#{background}"/>' + draw(foreground, "#fff", 528, 28, 0.6667) + "</g>")
+    svg.append('<rect x="610" y="40" width="48" height="48" fill="#222"/>'
+               + draw(notification, "#fff", 622, 52, 1))
+    svg.append(f'<rect x="30" y="280" width="500" height="120" fill="#{palette["gray200"]}"/>'
+               + draw(wordmark, f"#{palette['blue500']}", 62, 306, 2))
+    svg.append(f'<rect x="560" y="280" width="500" height="120" fill="#{palette["gray1200"]}"/>'
+               + draw(wordmark, f"#{palette['gray100']}", 592, 306, 2))
+    blues = [name for name in palette if name.startswith(("blue", "teal"))]
+    grays = [name for name in palette if name.startswith("gray")]
+    for row, names in enumerate((blues, grays)):
+        for index, name in enumerate(names):
+            svg.append(f'<rect x="{30 + index * 52}" y="{430 + row * 60}" width="48" height="48" '
+                       f'fill="#{palette[name]}"/>')
+    svg.append(f'<rect x="700" y="40" width="170" height="44" rx="22" fill="#{palette["blue500"]}"/>'
+               '<text x="785" y="68" font-family="Helvetica" font-size="16" fill="#fff" '
+               'text-anchor="middle">Log in</text>')
+    svg.append(f'<rect x="890" y="30" width="190" height="64" fill="#{palette["gray1200"]}"/>'
+               f'<rect x="900" y="40" width="170" height="44" rx="22" fill="#{palette["blue400"]}"/>'
+               f'<text x="985" y="68" font-family="Helvetica" font-size="16" '
+               f'fill="#{palette["gray1100"]}" text-anchor="middle">Log in</text>')
+    svg.append("</svg>")
+    OUT.mkdir(parents=True, exist_ok=True)
+    source = OUT / "brand.svg"
+    source.write_text("\n".join(svg), encoding="utf-8")
+    subprocess.run(["rsvg-convert", str(source), "-o", str(OUT / "brand.png")], check=True)
+    source.unlink()
+    print(f"Wrote {OUT / 'brand.png'}")
+
+
+if __name__ == "__main__":
+    main()
