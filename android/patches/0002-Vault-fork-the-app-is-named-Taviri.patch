-    <string name="bitwarden_tools">Εργαλεία Vault</string>
-    <string name="bitwarden_can_notify_you_each_time_you_receive_a_new_login_request_from_another_device">Το Vault μπορεί να σας ειδοποιεί κάθε φορά που λαμβάνετε ένα νέο αίτημα σύνδεσης από μια άλλη συσκευή.</string>
-    <string name="we_couldnt_verify_the_servers_certificate">Δεν μπορέσαμε να επαληθεύσουμε το πιστοποιητικό του διακομιστή. Η αλυσίδα πιστοποιητικού ή οι ρυθμίσεις διακομιστή μεσολάβησης στη συσκευή σας ή ο διακομιστής Vault σας ενδέχεται να μην ρυθμιστούν σωστά.</string>
-    <string name="after_you_save_your_new_password_to_bitwarden_don_t_forget_to_update_it_on_your_account_website">Αφού αποθηκεύσετε τον νέο κωδικό πρόσβασής σας στο Vault, μην ξεχάσετε να τον ενημερώσετε στην ιστοσελίδα του λογαριασμού σας.</string>
-    <string name="system_certificates_are_not_as_secure_as_importing_certificates_to_bitwarden">Η χρήση πιστοποιητικού συστήματος είναι λιγότερο ασφαλής από την αποθήκευση του πιστοποιητικού με το Vault. Η συνέχιση θα εμφανίσει μια λίστα διαθέσιμων πιστοποιητικών συστήματος αν υπάρχει ήδη εγκατεστημένο.</string>
-    <string name="logs_will_be_automatically_deleted_after_30_days">Τα αρχεία καταγραφής θα διαγράφονται αυτόματα μετά από 30 ημέρες. Το Vault μπορεί να έχει πρόσβαση στα δεδομένα καταγραφής σας μόνο όταν τα μοιράζεστε.</string>
-    <string name="for_details_on_what_is_and_isnt_logged">Για λεπτομέρειες σχετικά με το τι καταγράφεται και τι όχι, επισκεφτείτε το\n<annotation link="helpCenter">Κέντρο βοήθειας Vault.</annotation></string>
-    <string name="this_account_will_soon_be_deleted_log_in_at_x_to_continue_using_bitwarden">Αυτός ο λογαριασμός θα διαγραφεί σύντομα. Συνδεθείτε στο %1$s για να συνεχίσετε να χρησιμοποιείτε το Vault.</string>
-    <string name="dynamic_colors_may_not_adhere_to_accessibility_guidelines">Αυτό το χρωματικό σχήμα εφαρμόζει αυτόματα χρώματα συστήματος στο Vault με βάση την τρέχουσα ταπετσαρία σας. Αυτά τα χρώματα μπορεί να μην πληρούν όλες τις οδηγίες προσβασιμότητας.</string>
-    <string name="trusted_by_you_learn_more">Αυτές είναι εφαρμογές ή προγράμματα περιήγησης που το Vault δεν εμπιστεύεται από προεπιλογή, αλλά εσείς τα εμπιστεύεστε για την εκτέλεση λειτουργιών κλειδιού πρόσβασης.</string>
-    <string name="trusted_by_community_learn_more">Αυτές είναι εφαρμογές που δεν περιλαμβάνονται στο Google Play Store, αλλά το Vault τις εμπιστεύεται για την εκτέλεση λειτουργιών κλειδιού πρόσβασης αφού μέλη της κοινότητας τις χρησιμοποιήσουν και τις αναφέρουν ως ασφαλείς.</string>
-    <string name="privileged_apps_description">Για την προστασία των χρηστών από απόπειρες phishing, από προεπιλογή, το Vault ολοκληρώνει λειτουργίες κλειδιού πρόσβασης μόνο μέσω εφαρμογών ή προγραμμάτων περιήγησης που εμπιστεύονται η Google ή η κοινότητα του Vault.</string>
-    <string name="learn_more_about_using_passkeys_with_bitwarden">Μάθετε περισσότερα σχετικά με τη χρήση κλειδιών πρόσβασης με το Vault.</string>
