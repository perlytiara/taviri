+/**
+ * Vault fork: whether this environment is a placeholder, meaning no real server has been set
+ * yet. Placeholders use a host under `.invalid`, the domain reserved for names that never exist.
+ */
+val Environment.isPlaceholderServer: Boolean
+    get() = this
+        .environmentUrlData
+        .base
+        .substringAfter(delimiter = "://")
+        .substringBefore(delimiter = '/')
+        .substringBefore(delimiter = ':')
+        .endsWith(suffix = ".invalid", ignoreCase = true)
+
