 import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
 import org.junit.jupiter.api.Test
 
 class EnvironmentUrlsDataJsonExtensionsTest {
+    @Test
+    fun `isPlaceholderServer should be true only for hosts under the invalid domain`() {
+        fun selfHosted(base: String): Environment =
+            Environment.SelfHosted(environmentUrlData = EnvironmentUrlDataJson(base = base))
+
+        assertTrue(selfHosted("https://vault-pi.invalid").isPlaceholderServer)
+        assertTrue(selfHosted("https://vault-pi.INVALID:8443/path").isPlaceholderServer)
+        assertFalse(selfHosted("https://vault.example.ts.net").isPlaceholderServer)
+        assertFalse(selfHosted("https://192.168.1.20").isPlaceholderServer)
+        assertFalse(selfHosted("https://invalid.example.com/x.invalid").isPlaceholderServer)
+        assertFalse(Environment.Prod.Us.isPlaceholderServer)
+    }
